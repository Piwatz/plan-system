<%- include('partials/top') %>
<%# งานของฉันแบบ ก ชั้นปกแยกรายวิชา (ฟังก์ชันเสริม myshelf) ปุ่มเหมือนหน้าเดิม my.ejs ทุกปุ่ม · ปิดสวิตช์หรือเลือกหน้าเดิมแล้วกลับไปใช้ my.ejs %>
<% const T = wf.DOC_TYPES; %>
<div class="page-head">
  <div>
    <h1>งานของฉัน</h1>
    <div class="sub">แตะปกเล่มเพื่อดูรายละเอียดและดูว่าอนุมัติถึงใครแล้ว</div>
  </div>
  <div class="actions">
    <%- include('partials/term_select') %>
    <% if (isCurrent) { %>
      <% if (canPlan) { %><a class="btn btn-primary" href="/works/new?type=plan">ส่งแผน</a><% } %>
      <a class="btn btn-ghost" href="/works/new?type=manual">ส่งคู่มือรายวิชา</a>
    <% } %>
  </div>
</div>

<% if (isCurrent && !window.open) { %>
  <div class="alert alert-warn"><%= window.reason %> ยังบันทึกร่างไว้ก่อนได้ งานที่ถูกส่งกลับให้แก้ไขยังส่งใหม่ได้ตามปกติ</div>
<% } %>

<% if (!subjects.length) { %>
  <div class="card"><div class="empty"><span class="big"></span>ยังไม่มีงานในภาคเรียนนี้<br>เริ่มจากกด <b>ส่งคู่มือรายวิชา</b> หรือ <b>ส่งแผน</b> ของแต่ละรายวิชา</div></div>
<% } else { %>
  <div class="myc-sum">
    <div>งานทั้งหมด <b><%= counts.all %></b></div>
    <div class="s-wait">กำลังตรวจ <b><%= counts.pending %></b></div>
    <div class="s-back">ต้องแก้ไข <b><%= counts.returned %></b></div>
    <div class="s-ok">ผ่านครบ <b><%= counts.approved %></b></div>
    <% if (counts.draft) { %><div>ฉบับร่าง <b><%= counts.draft %></b></div><% } %>
  </div>
<% } %>

<% for (const s of subjects) { const p = s.plan && s.plan.status !== 'draft' ? s.plan : null; const noPlan = !s.plan && !canPlan; %>
  <section class="card myc-subj">
    <div class="card-head">
      <h2><%= s.code %> <%= s.name %></h2>
      <% if (s.grade) { %><span class="badge badge-brand"><%= s.grade %></span><% } %>
    </div>
    <div class="myc-shelf">
      <% for (const type of ['plan', 'manual']) { const w = s[type]; %>
        <% if (w) { %>
          <article class="myc-tile<%= w.status === 'returned' ? ' is-back' : '' %>">
            <a class="myc-cv" href="/s/<%= w.id %>" aria-label="ดูรายละเอียด<%= T[type].label %> <%= s.code %>"><%- include('partials/lib_cover', { b: w.book }) %></a>
            <div class="myc-bd">
              <b class="myc-kind"><%= T[type].label %></b>
              <div><%- include('partials/status', { s: w }) %></div>
              <% if (w.score_max) { %><div class="muted small">คะแนน <%= w.score_total %>/<%= w.score_max %> <%= wf.scoreLevel(w.score_total / w.score_max * 100) %></div><% } %>
              <%- include('partials/my_steps', { w }) %>
              <a class="btn btn-block myc-main <%= w.status === 'returned' ? 'btn-danger' : w.status === 'draft' ? 'btn-primary' : 'btn-ghost' %>" href="/s/<%= w.id %>"><%= w.status === 'returned' ? 'แก้ไขแล้วส่งใหม่' : w.status === 'draft' ? 'เปิดร่าง' : 'ดูรายละเอียด' %></a>
              <% if (ff.printrow && w.status !== 'draft') { %><div class="myc-links"><a href="/s/<%= w.id %>/print" target="_blank" rel="noopener">พิมพ์บันทึกข้อความ</a><% if (w.score_max) { %><a href="/s/<%= w.id %>/print?doc=eval" target="_blank" rel="noopener">พิมพ์แบบประเมิน</a><% } %><% if (w.main_file_id) { %><a href="/f/<%= w.main_file_id %>/view" target="_blank" rel="noopener">เปิดไฟล์<%= type === 'plan' ? 'แผน' : 'คู่มือ' %></a><% } %></div><% } %>
            </div>
          </article>
        <% } else { const send = isCurrent && (type !== 'plan' || canPlan); const other = s.manual || s.plan; %>
          <article class="myc-tile<%= send ? '' : ' is-empty' %>">
            <span class="myc-none"><%= type === 'plan' && noPlan ? 'ไม่ต้องส่ง' : 'ยังไม่ได้ส่ง' %></span>
            <div class="myc-bd">
              <b class="myc-kind"><%= T[type].label %></b>
              <div class="muted small"><%= type === 'plan' && noPlan ? 'ไม่ต้องส่ง ส่งแผนเฉพาะวิชาหลัก' : 'ยังไม่ได้ส่ง' %></div>
              <% if (send) { %><a class="btn btn-block btn-primary myc-main" href="/works/new?type=<%= type %><%= other ? '&from=' + other.id : '' %>">ส่ง<%= T[type].label %></a><% } %>
            </div>
          </article>
        <% } %>
      <% } %>
      <% if (p) { %>
        <article class="myc-tile">
          <a class="myc-cv" href="/s/<%= p.id %>#notes" aria-label="ดูบันทึกหลังแผนทั้งหมด <%= s.code %>"><%- include('partials/lib_cover', { b: p.noteBook }) %></a>
          <div class="myc-bd">
            <b class="myc-kind">บันทึกหลังแผน</b>
            <div class="muted small"><b class="myc-ink"><%= p.note_total %> ฉบับ</b> ลงนามครบ <%= p.note_done %></div>
            <% if (p.note_todo) { %><div><span class="badge badge-gray">ร่างหรือรอแก้ <%= p.note_todo %></span></div><% } %>
            <a class="btn btn-block btn-warn myc-main" href="/notes/new?plan=<%= p.id %>">เขียนบันทึก</a>
            <div class="myc-links"><a href="/s/<%= p.id %>#notes">ดูทั้งหมด</a><% if (ff.printrow && p.note_total - p.note_todo > 0) { %><a href="/s/<%= p.id %>/print-notes" target="_blank" rel="noopener">พิมพ์ทั้งเล่ม</a><% } %></div>
          </div>
        </article>
      <% } else { %>
        <article class="myc-tile is-empty">
          <span class="myc-none">ยังไม่มี</span>
          <div class="myc-bd">
            <b class="myc-kind">บันทึกหลังแผน</b>
            <div class="muted small">เขียนได้หลังจากส่งแผนการจัดการเรียนรู้ของวิชานี้แล้ว</div>
          </div>
        </article>
      <% } %>
    </div>
    <%# มือถือซ่อนกล่องว่างที่กดอะไรไม่ได้ เหลือบรรทัดนี้แทน หน้าจึงไม่ยาวเกินจำเป็น %>
    <% if (!s.plan && !(isCurrent && canPlan)) { %><div class="myc-hint muted small">แผนการจัดการเรียนรู้ <%= noPlan ? 'ไม่ต้องส่ง ส่งแผนเฉพาะวิชาหลัก' : 'ยังไม่ได้ส่ง' %></div><% } %>
  </section>
<% } %>
<%- include('partials/bottom') %>
