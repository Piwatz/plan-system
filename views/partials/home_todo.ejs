<%# งานที่ต้องทำต่อบนคอม มือถือมีรายการนี้อยู่แล้วด้านล่าง (ฟังก์ชันเสริม hometodo) งานรอลงนามและคำเตือนผู้ดูแลมีกล่องของตัวเอง %>
<% const homeTodo = nextUp.filter((n) => n.href !== '/inbox' && n.href !== '/admin/users'); if (homeTodo.length) { %>
<section class="card home-todo<%= ff.todoshort ? ' todo-short' : '' %>">
    <h2>สิ่งที่ต้องทำต่อ</h2>
    <%# แสดงน้อยลง (ฟังก์ชันเสริม todoshort) 3 งานแรกเรียงจากเรื่องด่วน ที่เหลือกดเปิดดู %>
    <% const htRow = (n) => { %><a class="ht-row" href="<%= n.href %>"><span class="ht-dot <%= n.tone === 'back' ? 'back' : '' %>"></span><span class="ht-text"><b><%= n.title %></b><% if (n.deskSub || n.sub) { %><span><%= n.deskSub || n.sub %></span><% } %></span><% if (n.act) { %><span class="btn btn-sm <%= n.tone === 'back' ? 'btn-danger' : 'btn-primary' %>"><%= n.act %></span><% } else { %><%- icon('next', 20) %><% } %></a><% }; const htShown = ff.todoshort ? 3 : 6; %>
    <% homeTodo.slice(0, htShown).forEach(htRow); %>
    <% if (ff.todoshort && homeTodo.length > htShown) { %><details class="ht-rest"><summary>ดูอีก <%= homeTodo.length - htShown %> งาน</summary><% homeTodo.slice(htShown).forEach(htRow); %></details>
    <% } else if (homeTodo.length > htShown) { %><a class="ht-more" href="/my">ดูงานทั้งหมด อีก <%= homeTodo.length - htShown %> งาน</a><% } %>
  </section>
<% } %>
