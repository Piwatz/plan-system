<%# รายการตรวจก่อนส่งแผนและคู่มือ (ฟังก์ชันเสริม precheck) · locals: pc (จาก checkInfo ใน work.js) sub files mode = form หรือ detail
   ข้อแดงและเขียว = ระบบรู้แน่นอน (ok bad) · ข้อส้ม = ระบบเดา ครูต้องดูเอง (look) · wait = กำลังตรวจ · หน้าเว็บอัปเดตสถานะเองใน app.js (data-ck) %>
<%
  const form = mode === 'form';
  const oldPdf = files.length === 1 && (!ff.pdfonly || files[0].mime === 'application/pdf') ? files[0] : null;
  const filled = Boolean(sub.subject_code && sub.subject_name && sub.grade_level);
  const w = pc.window;
  const dueText = !w.open ? w.reason + ' บันทึกร่างไว้ก่อนได้' : pc.daysLeft == null ? 'เปิดรับส่งอยู่' : (pc.daysLeft === 0 ? 'วันนี้วันสุดท้าย' : 'เหลือ ' + pc.daysLeft + ' วัน') + ' ถึง ' + util.thaiDate(settings.submit_end);
  const sigText = pc.hasSig ? 'มีแล้ว ใช้ในบันทึกข้อความที่พิมพ์จากระบบ' : ff.sigrequire ? 'ยังไม่มี กดส่งแล้วเซ็นในกรอบได้เลย หรือกดเซ็นตอนนี้' : 'ยังไม่มี บันทึกข้อความจะไม่มีลายเซ็นผู้สอน';
  const items = form ? [
    { k: 'fields', st: filled ? 'ok' : 'bad', block: 1, t: 'กรอกรหัสวิชา ชื่อวิชา และระดับชั้นครบ', s: filled ? [sub.subject_code, sub.subject_name, sub.grade_level].join(' ') : 'ยังกรอกไม่ครบ' },
    { k: 'docno', st: sub.doc_no ? 'ok' : 'bad', block: 1, hide: !ff.docnoreq || sub.submitted_at || !pc.owner, t: 'กรอกเลขที่บันทึกข้อความ', s: sub.doc_no ? 'ที่ ' + sub.doc_no : 'ขอเลขที่ห้องวิชาการ แล้วกรอกเฉพาะตัวเลข' },
    { k: 'pdf', st: oldPdf ? 'ok' : 'bad', block: ff.pdfonly ? 1 : 0, t: ff.pdfonly ? 'ไฟล์เป็น PDF ไฟล์เดียว' : 'มีไฟล์งาน', s: oldPdf ? 'ใช้ไฟล์เดิม ' + oldPdf.original_name : 'ยังไม่ได้เลือกไฟล์' },
    { k: 'open', st: 'wait', block: 1, tick: 'ck_open', hide: !oldPdf, t: 'เปิดไฟล์ได้ ไม่เสีย ไม่ติดรหัสผ่าน', s: 'กำลังตรวจ' },
    { k: 'dup', st: pc.dupNow ? 'bad' : 'ok', block: 1, hide: !ff.dupfile || (!oldPdf && !pc.dupNow), t: 'ไม่ซ้ำกับไฟล์ในงานอื่นของคุณ', s: pc.dupNow ? 'เป็นไฟล์เดียวกับ' + pc.dupNow + ' ที่แนบไว้แล้ว แนบไฟล์ของวิชานี้แทน' : 'ไม่ซ้ำ' },
    { k: 'sig', st: pc.hasSig ? 'ok' : 'bad', hide: !pc.owner, t: 'ลายเซ็นของคุณ', s: sigText, sign: !pc.hasSig },
    { k: 'window', st: w.open ? 'ok' : 'bad', block: 1, hide: !pc.needWindow, t: 'อยู่ในกำหนดส่ง', s: dueText },
    { k: 'cover', st: 'look', tick: ff.coverconfirm ? 'cover_ok' : 'ck_cover', t: 'หน้าแรกคือหน้าปก', s: ff.coverpreview ? 'ดูภาพหน้าปกที่จะส่งด้านบน ต้องเห็นชื่อวิชาและชื่อครู ไม่ใช่หน้าว่างหรือสารบัญ' : 'เปิดไฟล์ดูก่อนว่าหน้าแรกเป็นหน้าปก' },
    { k: 'blank', st: 'look', tick: 'ck_blank', hide: 1, t: 'หน้าแรกเกือบว่าง อาจไม่ใช่ปก', s: '' },
    { k: 'code', st: 'look', tick: 'ck_code', hide: 1, t: 'ไม่พบรหัสวิชาใน 3 หน้าแรก', s: '' },
    { k: 'fname', st: 'look', tick: 'ck_fname', hide: 1, t: 'ชื่อไฟล์มีรหัสวิชาอื่น', s: '' },
    { k: 'pages', st: 'look', tick: 'ck_pages', hide: 1, t: 'จำนวนหน้าน้อยผิดปกติ', s: '' },
  ] : [
    { k: 'fields', st: pc.miss.length ? 'bad' : 'ok', block: 1, t: 'ข้อมูลและไฟล์ครบ', s: pc.miss.length ? 'ยังขาด ' + pc.miss.join(' และ ') + ' กดแก้ไข' : [sub.subject_code, sub.subject_name, sub.grade_level].join(' ') },
    { k: 'dup', st: pc.dupNow ? 'bad' : 'ok', block: 1, hide: !ff.dupfile, t: 'ไม่ซ้ำกับไฟล์ในงานอื่นของคุณ', s: pc.dupNow ? 'เป็นไฟล์เดียวกับ' + pc.dupNow + ' ที่แนบไว้แล้ว กดแก้ไขแล้วแนบไฟล์ของวิชานี้แทน' : 'ไม่ซ้ำ' },
    { k: 'sig', st: pc.hasSig ? 'ok' : 'bad', hide: !pc.owner, t: 'ลายเซ็นของคุณ', s: sigText.replace(' หรือกดเซ็นตอนนี้', '') },
    { k: 'window', st: w.open ? 'ok' : 'bad', block: 1, hide: !pc.needWindow, t: 'อยู่ในกำหนดส่ง', s: dueText },
  ];
  const ICON = { ok: 'ok', bad: 'close', look: 'eye', wait: 'clock' };
  const shown = items.filter((x) => !x.hide);
  const done = shown.filter((x) => x.st === 'ok').length;
%>
<div class="cklist<%= done === shown.length ? ' all-ok' : '' %><%= form && ff.formshort ? ' ck-short' : '' %>" data-precheck data-mode="<%= mode %>"<% if (form) { %> data-dup="<%= JSON.stringify(pc.dup) %>" data-min-pages="<%= pc.minPages %>"<%- oldPdf && oldPdf.mime === 'application/pdf' ? ' data-old-file="' + Number(oldPdf.id) + '"' : '' %><%- ff.blankcover ? ' data-blank' : '' %><%- ff.pdfonly ? ' data-pdfonly' : '' %><%- ff.precheckforce ? ' data-force' : '' %><% } %>>
  <div class="ck-h"><%- icon('shield', 20) %><% if (form && ff.formshort) { %><span data-ck-left><%= done === shown.length ? 'ตรวจครบแล้ว พร้อมส่ง' : 'ก่อนส่ง เหลืออีก ' + (shown.length - done) + ' ข้อ' %></span><% } else { %><span>ก่อนส่ง ตรวจให้ครบ</span><% } %><span class="ckn" data-ck-count><%= done %>/<%= shown.length %></span></div>
  <% for (const x of items) { %>
    <div class="ck <%= x.st %>" data-ck="<%= x.k %>"<%- x.block ? ' data-block' : '' %><%- x.hide ? ' hidden' : '' %>>
      <span class="ckic" data-ck-ic><%- icon(ICON[x.st], 16) %></span>
      <div class="ck-t"><b data-ck-title><%= x.t %></b><small data-ck-sub><%= x.s %></small></div>
      <% if (x.sign && form && me && !me.signature && (ff.sigrequire || ff.signag)) { %><button type="button" class="btn btn-sm btn-primary" data-ck-sign>เซ็นตอนนี้</button><% } else if (x.sign) { %><a class="btn btn-sm btn-ghost" href="/profile">เซ็นในข้อมูลส่วนตัว</a><% } %>
      <% if (x.tick) { %><label class="tick"><input type="checkbox" name="<%= x.tick %>" value="1"> ดูแล้ว</label><% } %>
    </div>
  <% } %>
  <div class="ck-foot muted small" data-ck-foot>
    <% if (form) { %>ข้อแดงต้องแก้ก่อนจึงส่งได้ ข้อส้มระบบเดาไว้ ให้ดูเองด้วยตา<%= ff.precheckforce ? ' แล้วติ๊ก ดูแล้ว ทุกข้อ' : ' (ไม่ติ๊กก็ส่งได้)' %> บันทึกร่างได้ตลอดโดยไม่ต้องตรวจครบ
    <% } else { %>ข้อแดงต้องแก้ก่อนจึงส่งได้ กดแก้ไขเพื่อดูข้อส้มของไฟล์ (หน้าปก รหัสวิชา จำนวนหน้า)<% } %>
  </div>
</div>
