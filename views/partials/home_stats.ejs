<%# กล่องตัวเลขสรุปของครู · slim = แถบแถวเดียวบนมือถือ (ฟังก์ชันเสริม statslim) บนคอมเป็นกล่องใหญ่เสมอ locals: sentPct slim %>
<div class="grid-4<%= slim ? ' stats-slim' : '' %>"<%- slim ? '' : ' style="margin-bottom:18px"' %>>
    <a class="stat green st-sent" href="/my"><span class="label"><span class="fx-ic"><%- icon('send', 16) %></span>ส่งแล้ว</span><b class="num"><%= stats.sent %> / <%= stats.target || 0 %></b><span class="fx-bar" aria-hidden="true"><i style="width:<%= sentPct %>%"></i></span><span class="sub">ผ่านครบทุกระดับ <%= stats.approved %> ชิ้น</span></a>
    <a class="stat blue st-wait" href="/my"><span class="label"><span class="fx-ic"><%- icon('clock', 16) %></span>รอผู้ตรวจ</span><b class="num"><%= stats.pending %></b><span class="sub"><%= stats.pending ? 'อยู่ที่ ' + stats.pendingAt : 'ไม่มีงานค้างที่ผู้ตรวจ' %></span></a>
    <a class="stat st-back <%= stats.returned ? 'orange' : '' %>" href="/my"><span class="label"><span class="fx-ic"><%- icon('undo', 16) %></span>ต้องแก้ไข</span><b class="num"><%= stats.returned %></b><span class="sub"><%= stats.returned ? stats.returnedName : 'ไม่มีงานที่ต้องแก้' %></span></a>
    <a class="stat st-note" href="/notes"><span class="label"><span class="fx-ic"><%- icon('edit', 16) %></span>บันทึก<span class="lab-more">หลังแผน</span></span><b class="num"><%= stats.notes %></b><span class="sub"><%= stats.notesTodo ? 'ยังไม่ส่ง ' + stats.notesTodo + ' ฉบับ' : 'ส่งครบทุกฉบับ' %></span></a>
</div>
