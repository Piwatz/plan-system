<%- include('partials/top') %>
<div class="narrow" style="max-width:900px">
  <div class="page-head">
    <div>
      <div class="eyebrow">ภาคเรียนที่ <%= term.semester %>/<%= term.year %></div>
      <h1>รายวิชาที่สอน<%= forOther ? ' ของ' + who.full_name : '' %></h1>
      <div class="sub">คู่มือรายวิชาส่งทุกวิชาที่สอน<%= ff.onemain ? ' แผนการจัดการเรียนรู้ส่งเฉพาะวิชาหลัก ' + quota + ' วิชา' : ' แผนการจัดการเรียนรู้ส่งทุกวิชา' %></div>
    </div>
    <div class="actions"><a class="btn btn-ghost" href="<%= forOther ? '/admin/users/' + who.id : '/' %>"><%- icon('back', 18) %> กลับ</a></div>
  </div>

  <% const proxyNew = forOther && ff.proxynew && me.is_admin && who.is_teacher; %>
  <% if (forOther) { %>
    <div class="alert alert-info"><%- icon('shield') %><span>ผู้ดูแลระบบกำลังแก้รายวิชาแทนครู ทุกครั้งที่เพิ่มหรือเปลี่ยนจะบันทึกในประวัติ<% if (proxyNew) { %><br><b>วิชาที่ยังไม่ส่ง กดปุ่ม สร้างแทนครู เพื่อส่งคู่มือหรือแผนในชื่อของครู</b> เช่น ครูลาคลอด ครูป่วย<% } %></span></div>
  <% } %>

  <section class="card flush<%= teachStyle ? ' has-tc tc-' + teachStyle : '' %>">
    <div class="card-head"><h2>วิชาที่สอน <%= rows.length %> วิชา</h2></div>
    <% if (ff.onemain && !canSetMain) { %><p class="hint" style="padding:0 20px">ส่งแผนวิชาหลักครบ <%= quota %> วิชาแล้ว ถ้าต้องการเปลี่ยนวิชาหลัก ให้แจ้งผู้ดูแลระบบ</p><% } %>
    <% if (!rows.length) { %>
      <div class="empty" style="padding:22px 20px 26px"><p>ยังไม่มีรายวิชา เพิ่มวิชาที่สอนในภาคนี้ให้ครบทุกวิชาที่ช่องด้านล่าง<%= ff.onemain ? ' แล้วเลือกวิชาหลัก 1 วิชาสำหรับส่งแผน' : '' %></p></div>
    <% } %>
    <% for (const r of rows) { %>
      <div class="teach-row">
        <span class="subj"><b><%= r.subject_code %></b><%= r.subject_name %> <span class="muted"><%= r.grade_level %></span>
          <% if (ff.onemain && r.is_main) { %><span class="badge badge-blue"><%- icon('star', 14) %> วิชาหลัก</span><% } %>
        </span>
        <span class="small">คู่มือ
          <% if (r.manual) { %><a class="badge <%= r.manualCell.cls %>" href="/s/<%= r.manual.id %>"><%= r.manualCell.text %></a>
          <% } else if (!forOther) { %><a class="badge badge-gray" href="/works/new?type=manual&code=<%= encodeURIComponent(r.subject_code) %>">ยังไม่ส่ง กดเพื่อส่ง</a>
          <% } else { %><span class="badge badge-gray">ยังไม่ส่ง</span><% if (proxyNew) { %> <a class="btn btn-sm btn-primary" href="/works/new?type=manual&code=<%= encodeURIComponent(r.subject_code) %>&for=<%= who.id %>"><%- icon('plus', 16) %> สร้างแทนครู</a><% } %><% } %>
        </span>
        <span class="small">แผน
          <% if (r.plan) { %><a class="badge <%= r.planCell.cls %>" href="/s/<%= r.plan.id %>"><%= r.planCell.text %></a>
          <% } else if (!r.needPlan) { %><span class="badge badge-gray">ไม่ต้องส่ง</span>
          <% } else if (!forOther) { %><a class="badge badge-gray" href="/works/new?type=plan&code=<%= encodeURIComponent(r.subject_code) %>">ยังไม่ส่ง กดเพื่อส่ง</a>
          <% } else { %><span class="badge badge-gray">ยังไม่ส่ง</span><% if (proxyNew) { %> <a class="btn btn-sm btn-primary" href="/works/new?type=plan&code=<%= encodeURIComponent(r.subject_code) %>&for=<%= who.id %>"><%- icon('plus', 16) %> สร้างแทนครู</a><% } %><% } %>
        </span>
        <span class="actions"><%- include('partials/teach_acts', { r, link: false }) %></span>
      </div>
    <% } %>
    <% if (teachStyle && rows.length) { %>
    <%# จอมือถือ (ฟังก์ชันเสริม teachcards): วิชาละกล่อง คู่มือกับแผนแยกกัน หน้าตา 3 แบบอยู่ใน app.css (.tc-a .tc-b .tc-c) · จอกว้างยังเป็นแถวแบบเดิม %>
    <div class="tc-list">
      <% for (const r of rows) { %>
        <div class="tc-subj">
          <div class="tc-head"><b><%= r.subject_code %> <%= r.subject_name %></b><% if (r.grade_level) { %><span class="badge badge-gray"><%= r.grade_level %></span><% } %><% if (ff.onemain && r.is_main) { %><span class="badge badge-blue"><%- icon('star', 14) %> วิชาหลัก</span><% } %></div>
          <div class="tc-docs">
            <% for (const [type, long, short, w, c, need] of [['manual', 'คู่มือรายวิชา', 'คู่มือ', r.manual, r.manualCell, true], ['plan', 'แผนการจัดการเรียนรู้', 'แผน', r.plan, r.planCell, r.needPlan]]) {
              const send = w || !need ? '' : !forOther ? '/works/new?type=' + type + '&code=' + encodeURIComponent(r.subject_code) : proxyNew ? '/works/new?type=' + type + '&code=' + encodeURIComponent(r.subject_code) + '&for=' + who.id : '';
              const href = w ? '/s/' + w.id : send;
              const tone = !w ? (send ? 'go' : 'none') : { approved: 'ok', returned: 'back', pending: 'wait' }[w.status] || 'none';
              const go = send ? ['btn-primary', forOther ? 'สร้างแทนครู' : 'ส่ง' + short] : w && !forOther && w.status === 'returned' ? ['btn-danger', 'แก้ไขแล้วส่งใหม่'] : w && !forOther && w.status === 'draft' ? ['btn-primary', 'เปิดร่าง'] : null; %>
              <<%= href ? 'a' : 'div' %> class="tc-doc tone-<%= tone %>"<% if (href) { %> href="<%= href %>"<% } %>>
                <span class="tc-name"><b class="tc-l"><%= long %></b><b class="tc-sl"><%= short %></b></span>
                <% if (w || need) { %><span class="badge <%= c.cls %> tc-st"><%= c.text %></span><% } else { %><span class="muted small tc-st">ไม่ต้องส่ง</span><% } %>
                <% if (go) { %><span class="btn btn-sm <%= go[0] %> tc-go"><% if (send) { %><%- icon('plus', 16) %><% } %> <%= go[1] %></span><% } else if (w) { %><span class="tc-arr"><%- icon('next', 18) %></span><% } %>
              </<%= href ? 'a' : 'div' %>>
            <% } %>
          </div>
          <div class="tc-foot"><%- include('partials/teach_acts', { r, link: true }) %></div>
        </div>
      <% } %>
    </div>
    <% } %>
  </section>

  <% if (teachStyle && rows.length) { %><button class="tc-addbtn" type="button" data-tc-add><%- icon('plus', 18) %> เพิ่มวิชาที่สอน</button><% } %>
  <form class="card<%= teachStyle && rows.length ? ' tc-addform' : '' %>" id="teach-add" method="post" action="/teaching/add" data-confirm="เพิ่มวิชานี้ในรายวิชาที่สอน" data-ok-label="เพิ่มวิชา" style="margin-top:18px">
    <input type="hidden" name="u" value="<%= who.id %>">
    <h2>เพิ่มวิชาที่สอน</h2>
    <div class="form-grid">
      <div class="field">
        <label for="subject_code">รหัสวิชา <span class="req">*</span></label>
        <input type="text" id="subject_code" name="subject_code" list="subject-list" placeholder="เช่น ว30203" data-subject-code autocomplete="off" required>
        <datalist id="subject-list">
          <% for (const x of subjects) { %><option value="<%= x.code %>" data-name="<%= x.name %>" data-grade="<%= x.grade %>"><%= x.name %></option><% } %>
        </datalist>
      </div>
      <div class="field" style="grid-column:span 2">
        <label for="subject_name">ชื่อวิชา <span class="req">*</span></label>
        <input type="text" id="subject_name" name="subject_name" placeholder="เช่น ฟิสิกส์เพิ่มเติม 3" required>
      </div>
      <div class="field">
        <label for="grade_level">ระดับชั้น</label>
        <select id="grade_level" name="grade_level">
          <option value="">เลือกระดับชั้น</option>
          <% for (const g of util.lines(settings.grade_levels)) { %><option><%= g %></option><% } %>
        </select>
      </div>
    </div>
    <% if (ff.onemain && canSetMain) { %>
      <label class="check"><input type="checkbox" name="is_main" value="1" <%= rows.some((r) => r.is_main) ? '' : 'checked' %>> เป็นวิชาหลัก (วิชาที่ส่งแผนการจัดการเรียนรู้)</label>
    <% } %>
    <div class="btn-row" style="margin-top:14px"><button class="btn btn-primary" type="submit"><%- icon('plus', 18) %> เพิ่มวิชา</button></div>
    <p class="hint">พิมพ์รหัสวิชาแล้วระบบเติมชื่อวิชาให้ ถ้าเป็นวิชาที่มีในรายวิชาของโรงเรียน</p>
  </form>
  <% if (teachStyle && rows.length) { %><script>(function(){var b=document.querySelector('[data-tc-add]'),f=document.getElementById('teach-add');if(!b||!f)return;b.addEventListener('click',function(){f.classList.add('tc-open');b.hidden=true;var i=document.getElementById('subject_code');if(i)i.focus()})})();</script><% } %>
</div>
<%- include('partials/bottom') %>
