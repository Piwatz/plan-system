<%- include('partials/top') %>
<%
  const T = wf.DOC_TYPES;
  const first = me.full_name.replace(/^(นาย|นางสาว|นาง)\s*/, '').split(/\s+/)[0];
  // ร้อยละที่ส่งแล้ว ใช้กับแถบความคืบหน้าและวงแหวน (สีสัน 4 ระดับ colorful)
  const sentPct = me.is_teacher && stats.target ? Math.min(100, Math.round((stats.sent / stats.target) * 100)) : 0;
%>
<div class="hello<%= locals.fxLevel >= 3 ? ' fx-hello' : '' %><%= ff.helloslim ? ' hello-slim' : '' %>">
  <div>
    <div class="muted">ภาคเรียนที่ <%= term.semester %>/<%= term.year %></div>
    <h1>สวัสดี <%= me.is_teacher ? 'ครู' : 'คุณ' %><%= first %></h1>
  </div>
  <% if (window.open && settings.submit_end && daysLeft != null && daysLeft >= 0) { %>
    <span class="pill-note<%= daysLeft > 14 ? ' ok' : '' %>"><span class="pill-long"><%= daysLeft === 0 ? 'วันนี้วันสุดท้าย' : 'เหลืออีก ' + daysLeft + ' วัน' %> ถึงกำหนดส่งแผนและคู่มือ (<%= util.thaiDate(settings.submit_end, true) %>)</span><% if (ff.helloslim) { %><span class="pill-short"><%= daysLeft === 0 ? 'วันนี้วันสุดท้าย' : 'เหลือ ' + daysLeft + ' วัน' %> ส่งภายใน <%= util.thaiDate(settings.submit_end, true) %></span><% } %></span>
  <% } else if (window.open) { %>
    <span class="pill-note ok">เปิดรับส่งแผนและคู่มือ</span>
  <% } else { %>
    <span class="pill-note back"><%= window.reason %></span>
  <% } %>
  <% if (locals.fxLevel >= 3 && me.is_teacher && stats.target) { %>
    <span class="fx-ring" style="--p:<%= sentPct %>" role="img" aria-label="ส่งแล้วร้อยละ <%= sentPct %>"><b><%= sentPct %>%</b><small>ส่งแล้ว</small></span>
  <% } %>
</div>

<% if (ff.hometodo && !ff.homelayout) { %><div class="d-only"><%- include('partials/home_todo') %></div><% } %>
<% if (locals.dueAlert) { %><%# ใกล้กำหนดส่งแต่ยังมีงานที่ยังไม่ส่ง (ฟังก์ชันเสริม duealert) %>
  <div class="call must due-alert"><%- icon('clock') %>
    <div><span class="call-tag">ห้ามพลาด</span><b class="call-title"><%= dueAlert.days === 0 ? 'วันนี้วันสุดท้าย' : 'เหลืออีก ' + dueAlert.days + ' วัน' %> ถึงกำหนดส่ง ยังไม่ได้ส่ง <%= dueAlert.list.length %> งาน</b>
      <div class="call-links"><% for (const x of dueAlert.list) { %><a href="<%= x.href %>"><%= x.name %></a><% } %></div></div>
  </div>
<% } else if (locals.draftAlert && draftAlert.length) { %><%# แผนหรือคู่มือที่บันทึกร่างไว้แต่ยังไม่ได้กดส่ง %>
  <div class="call check draft-alert"><%- icon('note') %>
    <div><span class="call-tag">ควรตรวจ</span><b class="call-title">บันทึกร่างไว้ <%= draftAlert.length %> งาน ยังไม่ได้กดส่ง ผู้ตรวจยังไม่เห็น</b>
      <div class="call-links"><% for (const x of draftAlert) { %><a href="<%= x.href %>"><%= x.name %></a><% } %></div></div>
  </div>
<% } %>
<% if (sigNag && sigNag.proxy.length) { %><%- include('partials/sig_proxy', { proxy: sigNag.proxy }) %><% } %>
<% if (sigNag && sigNag.kind !== 'confirm') { %>
  <div class="<%= ff.callout ? 'call must' : 'alert alert-warn' %> sig-nag"><%- icon('edit') %>
    <div class="t">
<% if (ff.callout) { %><span class="call-tag">ห้ามพลาด</span><% } %>
<% if (sigNag.kind === 'none') { %>
      <b>คุณยังไม่มีลายเซ็น</b>
      <div class="small"><%= sigNag.blank ? 'บันทึกข้อความที่ส่งไปแล้ว ' + sigNag.blank + ' งานยังไม่มีลายเซ็นของคุณ เซ็นครั้งเดียว' + (ff.sigfillauto ? ' ระบบใส่ให้ทุกงาน' : ' แล้วกดใส่ในงานได้ทันที') : 'บันทึกข้อความที่ส่งจะมีลายเซ็นของคุณ เซ็นครั้งเดียวใช้ได้ทุกงาน' %></div>
      <div class="btn-row" style="margin-top:8px"><button type="button" class="btn btn-primary btn-sm" data-sig-open>เซ็นตอนนี้</button></div>
<% } else { %>
      <b>มี <%= sigNag.blank %> งานที่ส่งไปตอนยังไม่มีลายเซ็น</b>
      <div class="small">กดปุ่มเดียว ใส่ลายเซ็นของคุณในทุกงานนั้น ไม่ต้องส่งใหม่</div>
      <form method="post" action="/profile/sigfill" style="margin-top:8px" data-confirm="ใส่ลายเซ็นของคุณในงานที่ส่งไปตอนยังไม่มีลายเซ็นทั้ง <%= sigNag.blank %> งาน ใช่ไหม" data-ok-label="ใส่ลายเซ็น"><input type="hidden" name="back" value="/"><button class="btn btn-primary btn-sm" type="submit">ใส่ลายเซ็นของฉันในงานเหล่านี้</button></form>
<% } %>
    </div>
  </div>
<% } %>

<% if (warnings.length) { %>
  <div class="alert alert-warn"><%- icon('toggle') %>
    <div><b>สิ่งที่ผู้ดูแลระบบควรตั้งค่าให้ครบ</b>
      <ul><% for (const w of warnings.slice(0, 6)) { %><li><%= w %></li><% } %></ul>
      <% if (warnings.length > 6) { %><div>และอีก <%= warnings.length - 6 %> รายการ</div><% } %>
      <a class="btn btn-sm btn-ghost" href="/admin/users" style="margin-top:8px">ไปที่รายชื่อผู้ใช้</a>
    </div>
  </div>
<% } %>

<% if (backupProblem) { const bp = backupProblem; %>
  <div class="alert alert-warn alert-backup"><%- icon('backup') %>
<% if (bp.kind === 'fail') { %>
    <div><b>สำรองข้อมูลเมื่อคืนไม่สำเร็จ</b> <span class="small"><%= util.thaiDateTime(bp.at) %></span></div>
<% } else { %>
    <div><b>ไม่ได้สำรองข้อมูลมา <%= bp.days %> วันแล้ว</b><% if (bp.at) { %> <span class="small">ล่าสุด <%= util.thaiDateTime(bp.at) %></span><% } %></div>
<% } %>
    <a class="btn btn-sm btn-ghost" href="/admin#backup">ดูรายละเอียด</a>
  </div>
<% } %>

<% if (ff.alertstrip && alerts.length) { %><%# แถบเดียวแทนกล่องแจ้งเตือนหลายกล่อง (ฟังก์ชันเสริม alertstrip) %>
  <% if (homeAlerts.pc && homeAlerts.m) { %><%- include('partials/alert_strip') %><% } else if (homeAlerts.pc) { %><div class="d-only"><%- include('partials/alert_strip') %></div><% } else if (homeAlerts.m) { %><div class="m-only"><%- include('partials/alert_strip') %></div><% } %>
<% } else { %>
<% for (const a of alerts) { %>
  <div class="alert alert-warn"><%- icon('bell') %>
    <div><b><%= a.from_name || 'ระบบ' %></b> <span class="muted small"><%= util.ago(a.created_at) %></span><div class="pre"><%= a.text %></div></div>
    <a class="btn btn-sm btn-ghost" href="/alerts">ดูทั้งหมด</a>
  </div>
<% } %>
<% } %>

<% if (!me.signature && !sigNag) { %><%# แถบเตือนแบบเดิม ใช้เมื่อปิดฟังก์ชันเสริม signag %>
  <div class="alert alert-info"><%- icon('edit') %><span>คุณยังไม่ได้บันทึกลายเซ็น ลายเซ็นจะปรากฏในบันทึกข้อความและเอกสารที่พิมพ์ <a href="/profile"><b>เซ็นชื่อเลย</b></a></span></div>
<% } %>

<%# จัดลำดับบนมือถือ (ฟังก์ชันเสริม mobileorder) ต้องเปิด homelayout ด้วย ลำดับมาจาก homeMobileCss %>
<% const mobileOrder = ff.homelayout && ff.mobileorder; %>
<% if (mobileOrder) { %><style><%- homeMobileCss %></style><% } %>
<div class="m-only<%= mobileOrder ? ' hm-layout' : '' %>">
  <% if (mobileOrder && ff.statslim && me.is_teacher) { %><%- include('partials/home_stats', { sentPct, slim: true }) %><% } %>
  <section class="card m-next<%= ff.todoshort ? ' todo-short' : '' %>">
    <h2>สิ่งที่ต้องทำต่อ</h2>
    <% if (!nextUp.length) { %><p class="muted" style="margin:0">ไม่มีงานค้าง เรียบร้อยดีแล้ว</p><% } %>
    <%# แสดงน้อยลง (ฟังก์ชันเสริม todoshort) 3 งานแรกเรียงจากเรื่องด่วน ที่เหลือกดเปิดดู %>
    <% const mRow = (n) => { %><a class="m-next-row" href="<%= n.href %>"><span class="m-dot <%= n.tone %>"></span><span class="m-next-text"><b><%= n.title %></b><% if (n.sub) { %><span><%= n.sub %></span><% } %></span><%- icon('next', 20) %></a><% }; const mShown = ff.todoshort ? 3 : 6; %>
    <% nextUp.slice(0, mShown).forEach(mRow); %>
    <% if (ff.todoshort && nextUp.length > mShown) { %><details class="ht-rest"><summary>ดูอีก <%= Math.min(nextUp.length, 6) - mShown %> งาน</summary><% nextUp.slice(mShown, 6).forEach(mRow); %></details><% } %>
  </section>
  <% if (me.is_admin) { %>
    <div class="hm-admin">
    <div class="m-head"><h2>ผู้ดูแลระบบ</h2><span class="muted small">เฉพาะผู้ดูแลระบบเห็นส่วนนี้</span></div>
    <section class="card m-subj">
      <div class="m-tiles m-tiles-2">
        <% for (const [href, ic, label] of [['/admin/settings', 'school', 'ตั้งค่าโรงเรียนและธีม'], ['/admin/users', 'users', 'รายชื่อครูและผู้ตรวจ'], ['/admin/features', 'toggle', 'ฟังก์ชันเสริม'], ['/admin', 'flow', 'เมนูผู้ดูแลทั้งหมด']]) { %>
          <a class="m-tile m-tile-ic" href="<%= href %>"><%- icon(ic, 26) %><b><%= label %></b></a>
        <% } %>
      </div>
    </section>
    </div>
  <% } %>
  <div class="hm-subjects">
  <% if (me.is_teacher && ff.teachlist) { %>
    <div class="m-head"><h2>รายวิชาของฉัน</h2><a class="small" href="/teaching"><%= subjects.length ? 'แก้รายวิชาที่สอน' : 'เลือกรายวิชาที่สอน' %></a></div>
  <% } else if (me.is_teacher && subjects.length) { %>
    <div class="m-head"><h2>รายวิชาของฉัน</h2><span class="muted small">แตะช่องเพื่อส่งหรือดูงาน</span></div>
  <% } %>
  <% if (me.is_teacher && subjects.length) { %>
    <% for (const r of subjects) { %>
      <section class="card m-subj">
        <b class="m-subj-title"><%= r.code %> <%= r.name %><%= ff.onemain && r.needPlan ? ' (วิชาหลัก)' : '' %></b>
        <span class="muted small"><%= r.grade %></span>
        <% if (r.todoCount != null) { %><span class="todo-tag <%= r.todoCount ? '' : 'done' %>"><%= r.todoCount ? 'ต้องทำ ' + r.todoCount + ' อย่าง' : 'ทำครบแล้ว' %></span><% } %>
        <div class="m-tiles">
          <% r.cells.forEach((c, i) => { const tc = c.act ? (c.red ? 'tile-act red' : 'tile-act') : c.wait ? 'tile-wait' : c.off ? 'tile-off' : c.cls.replace('badge-', 'tile-'); %>
            <% if (c.href) { %><a class="m-tile <%= tc %>" href="<%= c.href %>"><% } else { %><span class="m-tile <%= tc %>"><% } %>
              <span><%= ['แผนการสอน', 'คู่มือรายวิชา', 'บันทึกหลังแผน'][i] %></span><b><%= c.text %></b>
            <%- c.href ? '</a>' : '</span>' %>
          <% }) %>
        </div>
      </section>
    <% } %>
  <% } %>
  </div>
  <% if (mobileOrder && locals.libRecent && (libRecent.length || locals.libStrip)) { %><%- include('partials/lib_strip', { books: libMobile, fill: false, compact: true }) %><% } %>
</div>
<div class="d-only<%= ff.homelayout ? ' home-layout' : '' %>">
<% if (locals.homeOrderCss) { %><style><%- homeOrderCss %></style><% } %>
<% if (ff.homelayout && locals.libRecent && (libRecent.length || locals.libStrip)) { %><%# จัดหน้าแรกใหม่ (ฟังก์ชันเสริม homelayout) เล่มใหม่อยู่ในกล่องจัดลำดับบนคอม มือถือคงไว้ท้ายหน้า %>
<%- include('partials/lib_strip', { books: libRecent, fill: true }) %>
<% } %>
<% if (ff.hometodo && ff.homelayout) { %><%- include('partials/home_todo') %><% } %>
<% if (inboxCount) { %>
  <div class="card review-panel">
    <div class="card-head">
      <h2>มีงานรอคุณลงนาม <%= inboxCount %> รายการ</h2>
      <div class="actions">
        <% if (inboxNotes && ff.quicksign) { %><a class="btn btn-ghost" href="/quicksign"><%- icon('cards', 18) %> <%= ff.notebook ? 'ลงนามบันทึกหลังแผนทีละเล่ม (' + inboxNotes + ' เล่ม)' : 'ลงนามบันทึกหลังแผนแบบไล่การ์ด (' + inboxNotes + ')' %></a><% } %>
        <a class="btn btn-primary" href="/inbox"><%- icon('inbox', 18) %> เปิดงานรอตรวจ</a>
      </div>
    </div>
    <div class="mini-list">
      <%# จัดหน้าแรกใหม่ (homelayout) แสดงแค่ 3 งาน แถวละบรรทัด ที่เหลือกดเปิดงานรอตรวจ %>
      <% for (const s of ff.homelayout ? inboxPreview.slice(0, 3) : inboxPreview) { %>
        <a class="mini-row" href="<%= s.book ? '/s/' + s.book.planId + '/book' : '/s/' + s.id %>">
          <span class="mr-main"><span class="badge badge-blue"><%= T[s.doc_type].label %></span><b><%= s.subject_code %> <%= s.subject_name %><%= s.doc_type === 'note' ? (s.book ? ' แผนที่ ' + s.book.planNos.map(planrange.short).join(' ') + ' (' + s.book.count + ' แผ่น)' : ' ' + planrange.label(s.plan_no)) : '' %></b><span><%= s.teacher_name %></span></span>
          <span class="btn btn-sm btn-primary">ตรวจ</span>
        </a>
      <% } %>
    </div>
  </div>
<% } %>

<% if (me.is_teacher) { %>
  <%- include('partials/home_stats', { sentPct, slim: false }) %>

  <div class="grid-3">
    <section class="card flush">
      <div class="card-head">
        <h2>รายวิชาของฉัน</h2>
        <div class="actions"><a class="btn btn-ghost" href="<%= ff.teachlist ? '/teaching' : '/works/new?type=' + (canPlan ? 'plan' : 'manual') %>"><%- icon(ff.teachlist ? 'edit' : 'plus', 18) %> <%= ff.teachlist ? 'แก้รายวิชาที่สอน' : 'เพิ่มรายวิชา' %></a></div>
      </div>
      <% if (!subjects.length) { %>
        <div class="empty" style="padding:28px 20px 34px">
          <% if (ff.teachlist) { %>
          <p>ยังไม่มีรายวิชาในภาคเรียนนี้ เริ่มจากเลือกวิชาที่สอนทุกวิชา<%= ff.onemain ? ' และวิชาหลักสำหรับส่งแผน' : '' %></p>
          <div class="btn-row" style="justify-content:center">
            <a class="btn btn-primary btn-lg" href="/teaching">เลือกรายวิชาที่สอน</a>
          </div>
          <% } else { %>
          <p>ยังไม่มีรายวิชาในภาคเรียนนี้ เริ่มจากส่งคู่มือรายวิชา หรือแผนการจัดการเรียนรู้</p>
          <div class="btn-row" style="justify-content:center">
            <a class="btn btn-primary btn-lg" href="/works/new?type=plan">ส่งแผนการจัดการเรียนรู้</a>
            <a class="btn btn-ghost btn-lg" href="/works/new?type=manual">ส่งคู่มือรายวิชา</a>
          </div>
          <% } %>
        </div>
      <% } else { %>
        <%# ปุ่มลงมือในช่อง (homeact) ไม่มีคอลัมน์ปุ่มท้ายแถว เขียนบันทึกฉบับถัดไปอยู่ใต้ช่องบันทึกหลังแผน %>
        <div class="rows-head<%= ff.homeact ? ' rows-act' : '' %>" style="margin-top:12px"><span>รายวิชา</span><span>แผนการสอน</span><span>คู่มือรายวิชา</span><span>บันทึกหลังแผน</span><% if (!ff.homeact) { %><span></span><% } %></div>
        <% for (const r of subjects) { %>
          <div class="rows-item<%= ff.homeact ? ' rows-act' : '' %>">
            <span class="subj"><b><%= r.code %><% if (ff.onemain && r.needPlan) { %> <span class="badge badge-blue fx-main" title="วิชาหลัก"><%- icon('star', 12) %> วิชาหลัก</span><% } %></b><span><%= r.name %> <%= r.grade %></span>
              <% if (r.todoCount != null) { %><span class="todo-tag <%= r.todoCount ? '' : 'done' %>"><%= r.todoCount ? 'ต้องทำ ' + r.todoCount + ' อย่าง' : 'ทำครบแล้ว' %></span><% } %></span>
            <% r.cells.forEach((c, i) => { %>
              <span><span class="cell-label"><%= ['แผนการสอน', 'คู่มือรายวิชา', 'บันทึกหลังแผน'][i] %></span>
                <% if (c.act) { %><a class="btn btn-sm cell-act <%= c.red ? 'btn-danger' : 'btn-primary' %>" href="<%= c.href %>"><%= c.text %></a>
                <% } else if (c.wait) { %><a class="cell-wait" href="<%= c.href %>" title="ต้องเขียนบันทึกหลังแผน หลังส่งแผนแล้ว"><%- icon('clock', 15) %> <%= c.text %></a>
                <% } else if (c.off) { %><span class="cell-off"><%= c.text %></span>
                <% } else if (c.href) { %><a class="badge st <%= c.cls %>" href="<%= c.href %>"><%= c.text %></a><% } else { %><span class="badge st <%= c.cls %>"><%= c.text %></span><% } %>
                <% if (ff.homeact && i === 2 && r.action) { %><a class="cell-more" href="<%= r.action.href %>"><%- icon('plus', 14) %> เขียนฉบับถัดไป</a><% } %>
              </span>
            <% }) %>
            <% if (!ff.homeact) { %><a class="btn btn-sm go <%= r.action.primary ? 'btn-primary' : 'btn-ghost' %>" href="<%= r.action.href %>"><%= r.action.label %></a><% } %>
          </div>
        <% } %>
      <% } %>
    </section>

    <% if (ff.homelayout) { %><details class="card home-activity"><summary>ความเคลื่อนไหวล่าสุด</summary><% } else { %><section class="card">
      <h2>ความเคลื่อนไหวล่าสุด</h2><% } %>
      <% if (!activity.length) { %>
        <p class="muted">ยังไม่มีผู้ตรวจลงนามในงานของคุณ</p>
      <% } else { %>
        <ul class="feed">
          <% for (const a of activity) { %>
            <li>
              <span class="fdot <%= a.action %>"></span>
              <span class="fbody">
                <% const book = a.planNos.length > 1; %>
                <a href="<%= book ? '/s/' + a.parent_id + '#notes' : '/s/' + a.submission_id %>"><b><%= T[a.doc_type].label %> <%= a.subject_code %><%= a.doc_type === 'note' ? (book ? ' ทั้งเล่ม ' + a.planNos.length + ' แผ่น' : ' ' + planrange.label(a.plan_no)) : '' %> <%= a.action === 'return' ? 'ถูกส่งกลับ' : 'ผ่าน ' + (util.SHORT_ROLE[a.role] || a.step_label) %></b></a>
                <span><%= a.user_name %> <%= a.score_max ? ' ได้ ' + a.score_total + ' คะแนน ระดับ' + wf.scoreLevel(a.score_total / a.score_max * 100) : '' %> <%= util.ago(a.created_at) %></span>
              </span>
            </li>
          <% } %>
        </ul>
      <% } %>
    <% if (ff.homelayout) { %></details><% } else { %></section><% } %>
  </div>

  <div class="card todo-bar">
    <div class="what">
      <% if (todo.length) { %>
        <b>ยังส่งไม่ครบ <%= todo.length %> รายการ</b>
        <span><%= todo.slice(0, 4).join('  ') %><%= todo.length > 4 ? ' และอีก ' + (todo.length - 4) + ' รายการ' : '' %></span>
      <% } else if (subjects.length) { %>
        <% if (locals.fxLevel >= 3) { %><span class="fx-medal" aria-hidden="true"><%- icon('star', 26) %></span><% } %>
        <% if (ff.confetti) { %><span hidden data-confetti-once="cw-allsent-<%= term.year %>-<%= term.semester %>-<%= me.id %>"></span><% } %>
        <b style="color:var(--ok)">ส่งครบทุกรายวิชาแล้ว</b>
        <span>อย่าลืมเขียนบันทึกหลังแผนหลังสอนแต่ละแผน</span>
      <% } else { %>
        <b>เริ่มต้นใช้งาน</b>
        <span>ส่งแผนการจัดการเรียนรู้และคู่มือรายวิชา รายวิชาละ 1 ชุดต่อภาคเรียน</span>
      <% } %>
    </div>
    <div class="btn-row">
      <a class="btn <%= ff.homelayout ? 'btn-ghost' : 'btn-primary btn-lg' %>" href="<%= todo.length && locals.mainHref && todo[0].startsWith('แผนวิชาหลัก') ? mainHref : '/works/new?type=' + (canPlan ? 'plan' : 'manual') %>">ส่งงานใหม่</a>
      <a class="btn btn-ghost<%= ff.homelayout ? '' : ' btn-lg' %>" href="/my">ดูงานทั้งหมด</a>
    </div>
  </div>
<% } else if (!inboxCount) { %>
  <div class="card home-empty"><div class="empty"><p>ขณะนี้ไม่มีงานรอคุณลงนาม</p><a class="btn btn-ghost" href="/stats">ดูสถิติโรงเรียน</a></div></div>
<% } %>
</div>
<% if (locals.libRecent && (libRecent.length || locals.libStrip)) { %>
  <% if (ff.homelayout) { %><% if (!mobileOrder) { %><div class="m-only"><%- include('partials/lib_strip', { books: libMobile, fill: false }) %></div><% } %>
  <% } else { %><%- include('partials/lib_strip', { books: libRecent, fill: false }) %><% } %>
<% } %>
<%- include('partials/bottom') %>
