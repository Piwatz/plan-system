<%- include('partials/top') %>
<% const qs = (extra) => new URLSearchParams({ ...query, ...extra }).toString(); %>
<%# หัวหน้าแบบกะทัดรัดบนมือถือ (ฟังก์ชันเสริม libslim) จัดด้วย CSS เท่านั้น จอคอมเหมือนเดิม %>
<div class="lib-head<%= ff.libslim ? ' slim' : '' %>">
<div class="page-head">
  <div>
    <h1>คลังงาน<span class="lib-t-more">การจัดการเรียนรู้</span></h1>
    <div class="sub"><%= showMode === 'sent' ? 'งานที่ส่งแล้ว เล่มที่ยังลงนามไม่ครบมีป้ายบอก' : 'งานที่ผ่านการตรวจครบทุกระดับแล้ว' %><%= ff.libread ? ' เปิดอ่านได้ทุกเล่ม' : ' ทุกคนเห็นปกและชื่อ เปิดอ่านได้เฉพาะงานของตัวเอง' %></div>
  </div>
  <div class="actions lib-views" role="group" aria-label="เลือกมุมมอง">
    <% for (const v of views) { %>
      <button type="button" class="btn btn-ghost" data-lib-view="<%= v.key %>" aria-label="<%= v.label %>" aria-pressed="false"><%- icon(v.icon, 18) %> <span class="lib-v-t"><%= v.label %></span></button>
    <% } %>
  </div>
</div>

<nav class="lib-shelves" aria-label="เลือกชั้น">
  <% for (const s of shelves) { %>
    <a class="<%= s.key === shelf.key ? 'on' : '' %>" href="/library?<%= qs({ shelf: s.key }) %>"<%- s.key === shelf.key ? ' aria-current="page"' : '' %>><span class="lib-s-long"><%= s.label %></span><span class="lib-s-short"><%= s.label.replace('การจัดการเรียนรู้', '').replace('รายวิชา', '') %></span></a>
  <% } %>
</nav>

<form method="get" action="/library" class="lib-filters" data-autosubmit>
  <input type="hidden" name="shelf" value="<%= shelf.key %>">
  <select id="lib-dept" name="department" aria-label="กลุ่มสาระ">
    <option value="">ทุกกลุ่มสาระ</option>
    <% for (const d of departments) { %><option value="<%= d.id %>" <%= department === d.id ? 'selected' : '' %>><%= d.name %></option><% } %>
  </select>
  <select id="lib-term" name="term" data-term aria-label="ภาคเรียน">
    <% for (const t of terms) { %><option value="<%= t.year %>-<%= t.semester %>" data-short="<%= t.semester %>/<%= t.year %>" <%= t.year === term.year && t.semester === term.semester ? 'selected' : '' %>>ภาคเรียน <%= t.semester %>/<%= t.year %></option><% } %>
  </select>
  <input type="hidden" name="year" value="<%= term.year %>"><input type="hidden" name="semester" value="<%= term.semester %>">
  <span class="lib-count">ทั้งหมด <b><%= total %></b> เล่ม</span>
  <% if (noCover) { %>
    <button type="submit" class="btn btn-sm btn-ghost lib-nocover" form="lib-covers"><%- icon('copy', 16) %> สร้างปกงานเดิม <%= noCover %> เล่ม</button>
  <% } %>
</form>
<% if (noCover) { %>
  <form id="lib-covers" method="post" action="/library/covers/done" data-covers data-confirm="สร้างรูปปกให้งานเดิมที่ผ่านครบแล้ว <%= noCover %> เล่ม
เครื่องนี้จะเปิดไฟล์ PDF ทีละเล่มแล้วทำรูปปกเล็ก อาจใช้เวลาหลายนาที ห้ามปิดหน้านี้จนกว่าจะเสร็จ" data-ok-label="สร้างปก"></form>
<% } %>

<% const toolsOn = manage || books.some((b) => b.swap); %>
<% if (toolsOn) { %><button type="button" class="lib-tools-btn" data-lib-tools aria-expanded="false"><%- icon('toggle', 16) %> เครื่องมือผู้ดูแล</button><% } %>
<div class="lib-tools" data-lib-tools-box>
<% if (manage) { const back = '/library?' + qs({}); %>
  <%# ผู้ดูแลระบบ (libshow) เปิดดูเล่มที่ซ่อนอยู่ (จาง ๆ) แล้วกดแสดงหรือซ่อนทีละเล่ม · ค่าหลักและรายครูตั้งในหน้าฟังก์ชันเสริม %>
  <div class="lib-showbar">
    <a class="btn btn-sm btn-ghost" href="/admin/features#libshow"><%- icon('toggle', 16) %> ตั้งค่างานที่แสดง</a>
    <% if (ff.readperm) { %><a class="btn btn-sm btn-ghost" href="/admin/readperm"><%- icon('lock', 16) %> สิทธิ์อ่านงาน</a><% } %>
    <a class="btn btn-sm <%= hidden ? 'btn-primary' : 'btn-ghost' %>" href="/library?<%= new URLSearchParams(Object.fromEntries(Object.entries({ ...query, hidden: hidden ? '' : '1' }).filter(([, v]) => v !== ''))) %>" aria-pressed="<%= hidden %>"><%- icon('eye', 16) %> เห็นเล่มที่ซ่อนอยู่</a>
  </div>
  <form id="lib-show-show" method="post" action="/library/show"><input type="hidden" name="want" value="show"><input type="hidden" name="back" value="<%= back %>"></form>
  <form id="lib-show-hide" method="post" action="/library/show"><input type="hidden" name="want" value="hide"><input type="hidden" name="back" value="<%= back %>"></form>
<% } %>

<% const swap = books.some((b) => b.swap); const pdfCover = books.some((b) => b.pdfCover); %>
<% if (swap) { const back = '/library?' + qs({}); %>
  <%# ผู้ดูแลระบบเปลี่ยนปก (coverswap): 2 โหมด สลับได้ เครื่องจำไว้ ปุ่มบนปกทีละเล่ม หรือเลือกหลายเล่มพร้อมกัน %>
  <div class="lib-swapbar" data-swapbar>
    <span class="lib-swap-mode" role="group" aria-label="วิธีเปลี่ยนปก">
      <b>เปลี่ยนปก</b>
      <button type="button" class="btn btn-sm btn-ghost" data-swap-mode="one" aria-pressed="true"><%- icon('copy', 16) %> ปุ่มบนปก</button>
      <button type="button" class="btn btn-sm btn-ghost" data-swap-mode="many" aria-pressed="false"><%- icon('check', 16) %> เลือกหลายเล่ม</button>
    </span>
    <span class="lib-swap-many">
      <span data-swap-count>ยังไม่ได้เลือก</span>
      <button type="submit" class="btn btn-sm btn-primary" form="lib-drawn" data-swap-go="drawn" data-confirm="เปลี่ยนเล่มที่เลือกเป็นปกที่ระบบวาดจากชื่อวิชาและชื่อครู แทนรูปหน้าแรกของไฟล์ ไฟล์งานไม่เปลี่ยน กดกลับไปใช้รูปจากไฟล์ได้ภายหลัง" data-ok-label="เปลี่ยนปก" disabled><%- icon('copy', 16) %> ใช้ปกระบบ</button>
      <button type="button" class="btn btn-sm btn-ghost" data-swap-go="file" disabled><%- icon('file', 16) %> ใช้รูปจากไฟล์</button>
      <% if (pdfCover) { %><button type="button" class="btn btn-sm btn-ghost" data-swap-go="pdf" disabled><%- icon('edit', 16) %> ต่อปกลงในไฟล์ PDF</button><% } %>
    </span>
  </div>
  <% if (pdfCover) { %>
    <%# ต่อปกที่ระบบวาดลงในไฟล์ทีละหลายเล่ม (libcoverpdf) 2 แบบ สลับได้ เครื่องจำไว้ · all ใช้กับทุกเล่ม · each ดูหน้า 1 ของทุกเล่มแล้วเลือกทีละเล่ม
        แต่ละเล่มส่งทางเดียวกับปุ่มเปลี่ยนปกในหน้างาน (POST /s/<id>/cover) ประวัติและ audit_log จดรายเล่ม %>
    <dialog class="modal front-dlg lp-dlg" id="lp-dlg" data-library="1" data-frontcheck="<%= ff.frontcheck ? '1' : '' %>">
      <h3 data-lp-title>ต่อปกที่ระบบวาดลงในไฟล์</h3>
      <p class="muted small">ปกแบบเดียวกับคลังงานเป็นหน้า 1 ของไฟล์ ไฟล์เดิมเก็บไว้ในไฟล์รุ่นก่อนแก้ไข ผู้ตรวจไม่ต้องลงนามใหม่</p>
      <div class="lib-swap-mode lp-mode" role="group" aria-label="วิธีเลือก">
        <button type="button" class="btn btn-sm btn-ghost" data-lp-mode="all" aria-pressed="true"><%- icon('check', 16) %> ใช้กับทุกเล่ม</button>
        <button type="button" class="btn btn-sm btn-ghost" data-lp-mode="each" aria-pressed="false"><%- icon('eye', 16) %> ดูหน้า 1 ทีละเล่ม</button>
      </div>
      <div class="lp-all" data-lp-all>
        <p class="front-step">หน้า 1 เดิมของไฟล์</p>
        <div class="front-opts">
          <label><input type="radio" name="lp_old" value="keep" checked> เก็บไว้ ต่อปกเพิ่มเป็นหน้าแรก <span class="muted small">ไฟล์ละ 1 หน้าเพิ่มขึ้น</span></label>
          <label><input type="radio" name="lp_old" value="del"> ลบหน้า 1 เดิม แล้วต่อปกแทน <span class="muted small">ใช้เมื่อหน้า 1 เดิมเป็นปกที่ผิด</span></label>
        </div>
      </div>
      <p class="front-step" data-lp-hint>เล่มที่เลือก</p>
      <div class="lp-list" data-lp-list></div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost btn-lg" data-lp-cancel>ยกเลิก</button>
        <button type="button" class="btn btn-primary btn-lg" data-lp-ok>ต่อปก</button>
      </div>
    </dialog>
  <% } %>
  <form id="lib-drawn1" method="post" action="/library/covers/drawn"><input type="hidden" name="back" value="<%= back %>"></form>
  <form id="lib-drawn" method="post" action="/library/covers/drawn"><input type="hidden" name="back" value="<%= back %>"></form>
<% } %>
</div>
</div>
<% if (ff.libslim) { %>
  <script>
    // มือถือ: ภาคเรียนใช้คำสั้นให้พอดีช่อง · เปิดพับเครื่องมือผู้ดูแล จอคอมไม่เปลี่ยน
    (function () {
      var phone = window.matchMedia('(max-width: 760px)');
      document.querySelectorAll('#lib-term option').forEach(function (o) {
        o.dataset.long = o.textContent;
        function fit() { o.textContent = phone.matches ? o.dataset.short : o.dataset.long; }
        fit();
        phone.addEventListener('change', fit);
      });
      <% if (toolsOn) { %>
      var btn = document.querySelector('[data-lib-tools]');
      var box = document.querySelector('[data-lib-tools-box]');
      var head = btn.closest('.lib-head');
      head.classList.add('has-tools');
      function set(open) {
        box.classList.toggle('open', open);
        head.classList.toggle('tools-open', open);
        btn.setAttribute('aria-expanded', String(open));
      }
      btn.addEventListener('click', function () { set(!box.classList.contains('open')); });
      // เลือกหลายเล่มค้างไว้ ต้องเห็นแถบปุ่มเปลี่ยนปก
      <% if (swap) { %>
      window.addEventListener('load', function () {
        var bar = document.querySelector('[data-swapbar]');
        if (bar && bar.getAttribute('data-swap') === 'many') set(true);
      });
      <% } %>
      <% } %>
    })();
  </script>
<% } %>

<% if (!books.length) { %>
  <div class="card"><div class="empty"><span class="big"><%- icon('books', 40) %></span><p>ยังไม่มี<%= shelf.label %><%= showMode === 'sent' ? 'ที่ส่งแล้ว' : 'ที่ผ่านครบ' %>ในภาคเรียนนี้<%= department ? ' ของกลุ่มสาระนี้' : '' %></p></div></div>
<% } else { %>
  <div class="card lib" data-lib data-default="<%= defaultView %>" data-view="shelf"<%- department ? ' data-one' : '' %><%- swap ? ' data-swap="one"' : '' %>>
    <script>(function(){var b=document.querySelector('[data-lib]'),k=['<%- views.map((v) => v.key).join("','") %>'],v='';try{v=localStorage.getItem('plan-libview')||''}catch(e){}if(k.indexOf(v)<0)v=b.getAttribute('data-default');if(k.indexOf(v)<0)v=window.matchMedia('(max-width: 760px)').matches?'list':'shelf';b.setAttribute('data-view',v)})()</script>
    <div class="lib-books" data-lib-books><%- include('partials/lib_books', { books, groups }) %></div>
    <% if (more) { %>
      <div class="lib-more"><a class="btn btn-ghost" href="<%= more %>" data-lib-more>แสดงทั้งหมดอีก <%= total - offset - books.length %> เล่ม</a></div>
    <% } %>
  </div>
<% } %>
<%- include('partials/bottom') %>
