<%- include('partials/top') %>
<%
  const T = wf.DOC_TYPES[sub.doc_type];
  const isNote = sub.doc_type === 'note';
  const methods = util.parseJson(sub.teaching_methods, []);
  const scoreDetail = util.parseJson(sub.score_detail, []);
  const current = files.filter((f) => f.is_current);
  const old = files.filter((f) => !f.is_current);
  const curStep = wf.stepOf(sub.current_role);
  const viewable = current.filter((f) => /^(application\/pdf|image\/)/.test(f.mime));
  // ผู้ลงนามบันทึกหลังแผน: อ่านเนื้อหาทางซ้าย ลงความเห็นทางขวา (มือถืออยู่ล่าง)
  const noteReview = canReview && isNote;
  const split = canReview && viewable.length > 0 && !noteReview;
  // รายการตรวจก่อนส่ง (ฟังก์ชันเสริม precheck): ข้อแดงที่ต้องแก้ก่อน ปุ่มส่งบอกเหตุผลแทนการส่ง
  const ckBlock = !locals.pc ? '' : pc.miss.length ? 'ยังส่งไม่ได้ ข้อมูลหรือไฟล์ยังไม่ครบ กดแก้ไขก่อน' : pc.dupNow ? 'ยังส่งไม่ได้ ไฟล์นี้เป็นไฟล์เดียวกับ' + pc.dupNow + ' กดแก้ไขแล้วแนบไฟล์ของวิชานี้' : pc.needWindow && !pc.window.open ? 'ยังส่งไม่ได้ ' + pc.window.reason : '';
%>
<div class="page-head">
  <div style="min-width:0">
    <div class="tags">
      <span class="badge badge-blue"><%= T.label %></span>
      <%- include('partials/status', { s: sub }) %>
      <span class="badge">ภาคเรียนที่ <%= sub.semester %>/<%= sub.academic_year %></span>
    </div>
    <h1 style="margin-top:8px">
      <%= isNote ? (planrange.scopeOf(sub.plan_no) === 'one' ? 'แผนการจัดการเรียนรู้ที่ ' + (sub.plan_no || '') : planrange.label(sub.plan_no)) + (sub.topic ? ' เรื่อง ' + sub.topic : '') : sub.subject_code + ' ' + sub.subject_name %>
    </h1>
    <div class="sub">
      <%= sub.teacher_name %> กลุ่มสาระ<%= sub.dept_name %>
      <% if (isNote && parent) { %> วิชา <a href="/s/<%= parent.id %>#notes"><%= parent.subject_code %> <%= parent.subject_name %></a><% } %>
    </div>
  </div>
  <div class="actions">
    <% if (isNote) { %>
      <a class="btn btn-ghost" href="/s/<%= sub.id %>/print" target="_blank" rel="noopener"><%- icon('print', 18) %> พิมพ์บันทึก</a>
    <% } else { %>
      <a class="btn btn-ghost" href="/s/<%= sub.id %>/print" target="_blank" rel="noopener"><%- icon('print', 18) %> บันทึกข้อความ</a>
      <% if (sub.score_max) { %><a class="btn btn-ghost" href="/s/<%= sub.id %>/print?doc=eval" target="_blank" rel="noopener"><%- icon('print', 18) %> แบบประเมิน</a><% } %>
    <% } %>
    <% if (canEdit && bookMode) { %>
      <a class="btn btn-ghost" href="/s/<%= sub.id %>/edit"><%- icon('edit', 18) %> แก้ไข</a>
      <a class="btn btn-primary" href="/s/<%= sub.parent_id %>#notes"><%- icon('send', 18) %> ไปหน้าส่งทั้งเล่ม</a>
    <% } else if (canEdit) { %>
      <a class="btn btn-ghost" href="/s/<%= sub.id %>/edit"><%- icon('edit', 18) %> แก้ไข</a>
      <form method="post" action="/s/<%= sub.id %>/submit" class="inline-form" data-busy="กำลังส่งงาน">
        <% const askCover = ff.coverconfirm && !isNote; %>
        <% if (askCover) { %><input type="hidden" name="cover_check" value="1"><label class="check cover-ok"><input type="checkbox" name="cover_ok" value="1"> <span>ฉันตรวจแล้ว <b>ไฟล์นี้มีหน้าปก</b> และ<b>หน้าปกอยู่หน้าแรก</b></span></label><% } %>
        <button class="btn btn-primary" type="submit"<% if (askCover) { %> data-need-checked="cover_ok" data-need-message="ติ๊กยืนยันก่อนว่าไฟล์นี้มีหน้าปก และหน้าปกอยู่หน้าแรก ถ้ายังไม่มีปก กดแก้ไขแล้วเพิ่มไฟล์ปก"<% } %> data-confirm="<%= isOwner ? 'ยืนยันส่ง' + T.label + 'ให้ผู้ตรวจ' : 'ส่งงานนี้แทน ' + sub.teacher_name + ' ระบบจะบันทึกว่าผู้ดูแลระบบส่งแทน' %>" data-ok-label="ส่งเลย"<%- isOwner ? ' data-need-sig' : '' %><% if (ckBlock) { %> data-blocked="<%= ckBlock %>"<% } %>><%- icon('send', 18) %> <%= !isOwner ? 'ส่งแทนครู' : sub.status === 'returned' ? 'ส่งอีกครั้ง' : 'ส่งให้ผู้ตรวจ' %></button>
      </form>
    <% } %>
    <% if (canWithdraw) { %>
      <form method="post" action="/s/<%= sub.id %>/withdraw" class="inline-form">
        <button class="btn btn-warn" type="submit" data-confirm="ดึงงานกลับมาแก้ไข
ผู้ตรวจจะไม่เห็นงานนี้จนกว่าคุณจะส่งอีกครั้ง"><%- icon('undo', 18) %> ดึงกลับมาแก้ไข</button>
      </form>
    <% } %>
    <% if (canDelete) { %>
      <form method="post" action="/s/<%= sub.id %>/delete" class="inline-form">
        <button class="btn btn-ghost" type="submit" data-danger="1" data-confirm="ลบงานนี้ถาวร<%= sub.doc_type === 'plan' ? ' รวมถึงบันทึกหลังแผนทั้งหมดของเล่มนี้' : '' %>
<%= ff.trashbin ? 'ลายเซ็นและคะแนนหายถาวร ส่วนไฟล์ผู้ดูแลระบบกู้คืนได้ภายใน 30 วัน' : 'ลบแล้วกู้คืนไม่ได้' %>" data-ok-label="ลบ"><%- icon('trash', 18) %> ลบ</button>
      </form>
    <% } %>
  </div>
</div>

<% if (flash && flash.sent && flash.sent.id === sub.id) { %><%- include('partials/sent_box') %><% } %>
<% if (sub.status === 'returned' && lastReturn && ff.retfocus) { %>
  <%- include('partials/return_box', { r: lastReturn, hint: !isOwner ? '' : bookMode ? 'กด <b>แก้ไข</b> ปรับตามความเห็น แล้วกด <b>ส่งทั้งเล่ม</b> ในหน้ารายวิชา' : 'กด <b>แก้ไข</b> ปรับตามความเห็น แล้วกดส่งอีกครั้ง งานจะกลับไปที่ผู้ส่งคืนโดยตรง' }) %>
<% } else if (sub.status === 'returned' && lastReturn) { %>
  <div class="alert alert-error"><%- icon('undo') %>
    <div><b><%= lastReturn.user_name %></b> (<%= lastReturn.step_label %>) ส่งกลับให้แก้ไข เมื่อ <%= util.thaiDateTime(lastReturn.created_at) %>
      <div class="pre" style="margin-top:6px;color:var(--ink)"><%= lastReturn.comment %></div>
      <% if (isOwner && bookMode) { %><div style="margin-top:8px">กด <b>แก้ไข</b> ปรับตามความเห็น แล้วกด <b>ส่งทั้งเล่ม</b> ในหน้ารายวิชา</div>
      <% } else if (isOwner) { %><div style="margin-top:8px">กด <b>แก้ไข</b> ปรับตามความเห็น แล้วกดส่งอีกครั้ง งานจะกลับไปที่ผู้ส่งคืนโดยตรง</div><% } %>
    </div>
  </div>
<% } else if (sub.status === 'draft' && isOwner) { %>
  <div class="<%= ff.callout ? 'call check' : 'alert alert-info' %>"><%- icon('note') %><span><% if (ff.callout) { %><span class="call-tag">ควรตรวจ</span><% } %>งานนี้ยังเป็นฉบับร่าง ผู้ตรวจจะยังไม่เห็นจนกว่าคุณจะกด <b><%= bookMode ? 'ส่งทั้งเล่ม' : 'ส่งให้ผู้ตรวจ' %></b><%= bookMode ? ' ในหน้ารายวิชา' : '' %></span></div>
<% } else if (sub.status === 'approved') { %>
  <div class="alert alert-success"><%- icon('ok') %><span><%= isNote ? 'ลงความเห็นครบทุกระดับแล้ว' : 'ผ่านการพิจารณาครบทุกระดับแล้ว' %> เมื่อ <%= util.thaiDateTime(sub.completed_at) %></span></div>
<% } %>

<%- include('partials/print_card', { hideBar: canReview || bookSign, firstTip: isOwner && sub.status !== 'draft' && !(flash && flash.sent) }) %>
<% if (locals.pc) { %><%- include('partials/precheck', { pc, sub, files: current, mode: 'detail' }) %><% } %>

<div class="card">
  <h3>เส้นทางการตรวจ</h3>
  <%- include('partials/stepper') %>
</div>

<% if (bookSign) { %>
  <div class="alert alert-info"><%- icon('books') %>
    <span>บันทึกหลังแผนลงนามทั้งเล่ม อ่านไล่ทุกแผ่นแล้วลงนามครั้งเดียว <a class="btn btn-sm btn-primary" href="/s/<%= sub.parent_id %>/book">เปิดลงนามทั้งเล่ม</a></span>
  </div>
<% } %>

<% if (canReview) {
  const maxTotal = rubric.reduce((a, it) => a + it.max_score, 0);
  const prev = Object.fromEntries(scoreDetail.map((d) => [d.id, d.score]));
  const sayList = isNote ? sayNote : sayWork;
%>
  <div class="<%= split ? 'review-split' : noteReview ? 'review-split note-review' : '' %>">
    <% if (split) { %>
      <%- include('partials/file_viewer', { files: viewable }) %>
    <% } else if (noteReview) { %>
      <div class="note-read">
        <%- include('partials/detail_info', { sub, isNote, methods }) %>
        <% if (viewable.length) { %><%- include('partials/file_viewer', { files: viewable, cls: 'inline' }) %><% } %>
      </div>
    <% } %>

    <form class="card review-panel score-panel" id="review-form" method="post" action="/s/<%= sub.id %>/approve" data-busy="กำลังลงนาม">
      <h2>ลงความเห็นในฐานะ<%= curStep.label %></h2>
      <% if (isOwner) { %><p class="hint" style="margin-top:0">งานของคุณเอง ระบบเปิดให้ลงนาม<%= needsScore ? 'และให้คะแนน' : '' %>ในฐานะ<%= curStep.label %>ได้</p><% } %>
      <% if (needsScore) { %>
        <div data-rubric data-max="<%= maxTotal %>" data-count="<%= rubric.length %>">
          <div class="sp-head">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap">
              <b>แบบประเมิน<%= T.label %></b>
              <span class="muted small">ให้แล้ว <span data-done>0</span> จาก <%= rubric.length %> ข้อ</span>
            </div>
            <div class="score-meter" style="margin-top:6px"><div data-meter></div></div>
            <div class="fill-row">
              <button type="button" class="btn btn-primary" data-fill-btn="5">ให้ 5 ทุกข้อ</button>
              <button type="button" class="btn btn-soft" data-fill-btn="4">4 ทุกข้อ</button>
              <button type="button" class="btn btn-ghost" data-fill-btn="0">ล้าง</button>
            </div>
            <span class="muted small">5 มากที่สุด 4 มาก 3 ปานกลาง 2 น้อย 1 น้อยที่สุด กดให้ทุกข้อก่อน แล้วค่อยแก้บางข้อได้</span>
          </div>
          <div class="rubric-list" id="rubric-list">
            <% rubric.forEach((it, i) => { %>
              <div class="rubric-item">
                <span><b><%= i + 1 %>.</b> <%= it.title %></span>
                <div class="score-pick" role="radiogroup" aria-label="คะแนนข้อ <%= i + 1 %>">
                  <% for (let v = it.max_score; v >= 1; v--) { %>
                    <label><input type="radio" name="score_<%= it.id %>" value="<%= v %>" <%= prev[it.id] === v ? 'checked' : '' %> required aria-label="ข้อ <%= i + 1 %> ให้ <%= v %>"><span><%= v %></span></label>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="score-total">รวม <b data-total>0</b> จาก <%= maxTotal %> <span class="badge badge-blue" data-level></span></div>
        </div>
      <% } %>
      <div class="field" style="margin-top:12px">
        <label for="comment">ความเห็นของ<%= curStep.label %></label>
        <textarea id="comment" name="comment" style="min-height:80px" placeholder="<%= isNote ? 'เช่น รับทราบ ควรเพิ่มกิจกรรมเสริมสำหรับนักเรียนที่ยังไม่ผ่านเกณฑ์' : 'เช่น เห็นควรอนุญาตให้ใช้ หรือสิ่งที่ต้องปรับแก้' %>"></textarea>
        <%- include('partials/saychips', { target: 'comment', says: sayList, saved }) %>
      </div>
      <div class="field">
        <span class="label">ลายเซ็น</span>
        <% if (me.signature) { %>
          <div class="btn-row"><span class="sig-box"><img class="sig-preview" src="<%= me.signature %>" alt="ลายเซ็นของคุณ"></span> <small class="muted">ใช้ลายเซ็นที่บันทึกไว้ <a href="/profile">เปลี่ยนลายเซ็น</a></small></div>
        <% } else { %>
          <%- include('partials/sigpad', { remember: true }) %>
          <% if (!ff.resign) { %><div class="hint">ระบบจะจำลายเซ็นนี้ไว้ ครั้งต่อไปไม่ต้องเซ็นใหม่</div><% } %>
        <% } %>
      </div>
      <div class="qs-actions">
        <button class="btn btn-ghost btn-lg" type="submit" formaction="/s/<%= sub.id %>/return" formnovalidate
          data-require-field="comment" data-require-message="กรุณาเขียนสิ่งที่ครูต้องแก้ไขในช่องความเห็นก่อนส่งกลับ"
          data-confirm="ยืนยันส่งกลับให้ครูแก้ไข" data-danger="1" data-ok-label="ส่งกลับ"><%- icon('undo', 20) %> ส่งกลับแก้ไข</button>
        <button class="btn btn-success btn-lg" type="submit"
          <% if (!me.signature) { %>data-require-field="signature" data-require-message="กรุณาเซ็นชื่อในกรอบก่อน"<% } %>
          data-confirm="ยืนยัน<%= approveLabel %><%= needsScore ? ' พร้อมคะแนนที่ให้' : '' %>" data-ok-label="<%= approveLabel %>"><%- icon('ok', 20) %> <%= approveLabel %></button>
      </div>
    </form>
  </div>
  <% if (needsScore) { %>
    <div class="sheet-bar<%= ff.mobilesheet ? ' mini' : '' %>" data-sheet>
      <% if (ff.mobilesheet) { %>
        <div class="sb-mini">
          <span class="sb-total"><b>ให้แล้ว <span data-done>0</span>/<%= rubric.length %> ข้อ</b><br><small class="muted">รวม <span data-total>0</span> จาก <%= maxTotal %></small></span>
          <button type="button" class="btn btn-primary" data-sheet-open>ให้คะแนนและลงนาม</button>
        </div>
        <div class="sb-full">
        <div class="sb-head"><b>ให้คะแนนและลงนาม</b><button type="button" class="btn btn-sm btn-ghost" data-sheet-close>ปิด</button></div>
      <% } %>
      <div class="sb-top">
        <span class="sb-total"><b>แบบประเมิน ให้แล้ว <span data-done>0</span> จาก <%= rubric.length %> ข้อ</b><br><small class="muted">รวม <span data-total>0</span> จาก <%= maxTotal %></small></span>
        <button type="button" class="sb-link" data-goto="rubric-list">ขยายดูรายข้อ</button>
      </div>
      <div class="sb-btns">
        <button type="button" class="btn btn-soft btn-lg" data-fill-btn="5">ให้ 5 ทุกข้อ</button>
        <button type="button" class="btn btn-ghost btn-lg" data-goto="rubric-list">ปรับรายข้อ</button>
      </div>
      <button class="btn btn-primary btn-lg btn-block" type="submit" form="review-form"
        <% if (!me.signature) { %>data-require-field="signature" data-require-message="กรุณาเซ็นชื่อในกรอบก่อน"<% } %>
        data-confirm="ยืนยัน<%= approveLabel %> พร้อมคะแนนที่ให้" data-ok-label="<%= approveLabel %>"><%- icon('edit', 20) %> <%= approveLabel %></button>
      <button type="button" class="sb-link sb-back" data-goto="comment">ส่งกลับให้ครูแก้ไข</button>
      <% if (ff.mobilesheet) { %></div><% } %>
    </div>
    <% if (ff.mobilesheet) { %><div class="sheet-scrim" data-sheet-close></div><% } %>
  <% } else if (noteReview && ff.mobilesheet) { %>
    <%# บันทึกหลังแผนบนมือถือ: แถบเล็กบรรทัดเดียว แตะแล้วเลื่อนไปช่องความเห็นและปุ่มลงนาม %>
    <div class="sheet-bar mini" data-sheet>
      <div class="sb-mini">
        <span class="sb-total"><b>อ่านจบแล้ว</b><br><small class="muted">เลื่อนไปลงความเห็น</small></span>
        <button type="button" class="btn btn-primary" data-goto="review-form">ลงความเห็นและลงนาม</button>
      </div>
    </div>
  <% } %>
<% } %>

<% if (me.is_admin && !isOwner && sub.status !== 'approved') { %>
  <form class="card admin-tools" method="post" action="/s/<%= sub.id %>/admin-finish" data-busy="กำลังดำเนินการแทน">
    <div class="card-head"><h3><%- icon('shield', 20) %> เครื่องมือผู้ดูแลระบบ</h3><span class="badge badge-amber">เฉพาะผู้ดูแลระบบเห็น</span></div>
    <p class="muted small">ใช้เมื่องานค้างนาน ระบบไม่ส่งข้อความแจ้งใคร แต่บันทึกในประวัติว่าผู้ดูแลระบบดำเนินการแทน ไม่ใส่ลายเซ็นของผู้อื่น ช่องลายเซ็นในเอกสารเว้นไว้ให้เซ็นด้วยมือ</p>
    <div class="field"><label for="admin-note">หมายเหตุ (ไม่บังคับ)</label><input type="text" id="admin-note" name="comment" maxlength="300" placeholder="<%= ff.adminreturn ? 'เช่น กรุณาเพิ่มหน้าปก (ส่งกลับต้องเขียน ครูจะเห็น)' : 'เช่น ครูส่งเอกสารกระดาษแล้ว ผู้บริหารลงนามในกระดาษ' %>"></div>
    <div class="btn-row">
      <% if (canEdit) { %><a class="btn btn-ghost" href="/s/<%= sub.id %>/edit"><%- icon('edit', 18) %> แก้ไขแทนครู</a><% } %>
      <% if (sub.status === 'pending' && curStep) { %>
        <button class="btn btn-warn" type="submit" formaction="/s/<%= sub.id %>/admin-advance" data-confirm="ดำเนินการแทน<%= curStep.label %>
งานจะไปต่อระดับถัดไป" data-ok-label="ดำเนินการแทน"><%- icon('next', 18) %> ดำเนินการแทน<%= curStep.label %></button>
      <% } %>
      <% if (ff.adminreturn && sub.status === 'pending' && curStep) { %>
        <button class="btn btn-ghost" type="submit" formaction="/s/<%= sub.id %>/admin-return" data-require-field="comment" data-require-message="เขียนสิ่งที่ครูต้องแก้ในช่องหมายเหตุก่อน เช่น กรุณาเพิ่มหน้าปก ครูจะเห็นข้อความนี้" data-confirm="ส่งกลับให้ <%= sub.teacher_name %> แก้ไขแทน<%= curStep.label %>
ครูแก้แล้วส่งใหม่ งานจะกลับมารอที่<%= curStep.label %> ลายเซ็นที่ลงไว้แล้วยังอยู่" data-ok-label="ส่งกลับ"><%- icon('undo', 18) %> ส่งกลับให้ครูแก้</button>
      <% } %>
      <button class="btn btn-primary" type="submit" data-confirm="ให้งานนี้ผ่านครบทุกระดับทันที
ระบบบันทึกว่าผู้ดูแลระบบดำเนินการแทน" data-ok-label="ให้ผ่านทั้งหมด"><%- icon('ok', 18) %> ให้ผ่านครบทุกระดับทันที</button>
    </div>
  </form>
<% } %>

<% if (locals.transferTo) { %>
  <%# โอนงานนี้ให้ครูคนอื่น แบบ ก (ฟังก์ชันเสริม transfer) หลายงานพร้อมกันใช้หน้า /admin/transfer %>
  <details class="card tf-card">
    <summary class="card-head"><h3><%- icon('users', 20) %> โอนงานนี้ให้ครูคนอื่น</h3><span class="badge badge-amber">เฉพาะผู้ดูแลระบบเห็น</span></summary>
    <form method="post" action="/admin/transfer" data-busy="กำลังโอนงาน" data-confirm="โอน<%= T.label %> <%= sub.subject_code %> ของ <%= sub.teacher_name %> ให้ครูที่เลือก ระบบจดในประวัติของงาน" data-ok-label="โอนงาน">
      <input type="hidden" name="ids" value="<%= sub.id %>"><input type="hidden" name="back" value="/s/<%= sub.id %>">
      <p class="muted small">เช่น ครูสอนแทนส่งไว้ แล้วครูเจ้าของวิชากลับมา โอนได้ทุกสถานะ ลายเซ็นผู้ตรวจอยู่ครบ โอนหลายงานพร้อมกันใช้ <a href="/admin/transfer?from=<%= sub.teacher_id %>&year=<%= sub.academic_year %>&semester=<%= sub.semester %>">หน้าโอนงานระหว่างครู</a></p>
      <div class="field"><label for="tf-to">โอนให้ครู</label>
        <select id="tf-to" name="to" required><option value="">เลือกครูผู้รับ</option>
          <% for (const t of transferTo) { %><option value="<%= t.id %>"><%= t.full_name %> (<%= t.dept_name || 'ไม่ระบุกลุ่มสาระ' %>)</option><% } %>
        </select></div>
      <%- include('partials/transfer_opts', { notes: sub.doc_type === 'plan' ? notes.length : 0, code: sub.subject_code }) %>
      <button class="btn btn-warn" type="submit"><%- icon('send', 18) %> โอนงาน</button>
    </form>
    <% if (driveLeft) { %>
      <form method="post" action="/admin/transfer/drive" data-confirm="ย้ายไฟล์ใน Google Drive ที่รออยู่ไปโฟลเดอร์ของครูเจ้าของงานตอนนี้" data-ok-label="ย้ายไฟล์" class="tf-drive"><input type="hidden" name="back" value="/s/<%= sub.id %>"><span class="muted small">ไฟล์ใน Drive รอย้าย <%= driveLeft %> ไฟล์ ระบบย้ายต่อเองทุกชั่วโมง</span> <button class="btn btn-sm btn-ghost" type="submit">ย้ายไฟล์ต่อ</button></form>
    <% } %>
  </details>
<% } %>

<%# แสดงไฟล์ที่ครูส่งให้อ่านในหน้านี้เลย เลื่อนดูได้ทุกหน้า (ผู้ตรวจที่กำลังให้คะแนนเห็นแบบแบ่งจอด้านบนอยู่แล้ว) %>
<% if (!split && !noteReview && viewable.length) { %><%- include('partials/file_viewer', { files: viewable, cls: 'inline' }) %><% } %>

<div class="grid-3">
  <div>
    <% if (!noteReview) { %><%- include('partials/detail_info', { sub, isNote, methods }) %><% } %>

    <% if (sub.score_max) { const pct = sub.score_total / sub.score_max * 100; %>
      <div class="card">
        <div class="card-head"><h3>ผลการประเมิน</h3>
          <div class="actions"><span class="badge badge-green" style="font-size:.95rem"><%= sub.score_total %> / <%= sub.score_max %> ระดับ<%= wf.scoreLevel(pct) %></span></div></div>
        <details>
          <summary class="muted" style="cursor:pointer">ดูคะแนนรายข้อ</summary>
          <div class="table-wrap"><table class="table" style="margin-top:8px">
            <% scoreDetail.forEach((d, i) => { %><tr><td><%= i + 1 %>. <%= d.title %></td><td class="num"><%= d.score %>/<%= d.max %></td></tr><% }) %>
          </table></div>
        </details>
      </div>
    <% } %>

    <% if (sub.doc_type === 'plan') { const todo = notes.filter((n) => n.status === 'draft' || n.status === 'returned'); %>
      <div class="card" id="notes">
        <div class="card-head">
          <h3>บันทึกหลังแผน <span class="muted">(<%= notes.length %> ฉบับ)</span></h3>
          <div class="actions">
            <% if (notes.some((n) => n.status !== 'draft')) { %><a class="btn btn-ghost btn-sm" href="/s/<%= sub.id %>/print-notes" target="_blank" rel="noopener"><%- icon('print', 16) %> พิมพ์ทั้งเล่ม</a><% } %>
            <% if (isOwner && sub.status !== 'draft') { %><a class="btn btn-primary btn-sm" href="/notes/new?plan=<%= sub.id %>"><%- icon('plus', 16) %> เขียนบันทึกหลังแผน</a><% } %>
          </div>
        </div>
        <% if (ff.notebook && bookWaiting) { %>
          <div class="alert alert-info"><%- icon('books') %><span>เล่มนี้มี <b><%= bookWaiting %> แผ่น</b> รอคุณลงนาม <a class="btn btn-sm btn-primary" href="/s/<%= sub.id %>/book">เปิดลงนามทั้งเล่ม</a></span></div>
        <% } %>
        <% if (memoBox) { %>
          <%# บันทึกข้อความส่งบันทึกหลังสอน 1 ฉบับต่อเล่ม (ฟังก์ชันเสริม notememo) เลขกรอกครั้งเดียว ทุกแผ่นในเล่มใช้เลขนี้ (notedocno) %>
          <div class="memo-box">
            <b class="mb-t"><%- icon('file', 18) %> บันทึกข้อความส่งบันทึกหลังสอน <span class="muted">(1 ฉบับต่อเล่ม)</span></b>
            <% if (memoBox.edit) { %>
              <form method="post" action="/s/<%= sub.id %>/notememo-no" class="mb-no" data-confirm="บันทึกเลขที่บันทึกข้อความของเล่มนี้ ทุกแผ่นในเล่มใช้เลขนี้" data-ok-label="บันทึกเลข">
                <label for="memo_no" class="mb-l">ที่</label>
                <div class="docno-in"><span><%= memoBox.pre %></span><input type="text" id="memo_no" name="doc_no_num" inputmode="numeric" maxlength="6" value="<%= docno.numOf(memoBox.no) %>" placeholder="เลขที่ขอ" autocomplete="off"><span>/<%= memoBox.year %></span></div>
                <button class="btn btn-sm btn-ghost" type="submit">บันทึกเลข</button>
              </form>
            <% } else if (memoBox.no) { %>
              <span>ที่ <%= memoBox.no %></span>
            <% } %>
            <% if (memoBox.sent) { %>
              <a class="btn btn-sm btn-primary" href="/s/<%= sub.id %>/print-notememo" target="_blank" rel="noopener"><%- icon('print', 16) %> พิมพ์บันทึกข้อความ</a>
            <% } else { %>
              <span class="hint">พิมพ์ได้เมื่อส่งทั้งเล่มแล้ว</span>
            <% } %>
          </div>
        <% } %>
        <% if (!notes.length) { %>
          <div class="empty"><%= sub.status === 'draft' ? 'ส่งแผนเล่มนี้ก่อน แล้วจึงเขียนบันทึกหลังแผนได้' : 'ยังไม่มีบันทึกหลังแผน' %></div>
        <% } else { %>
          <% const bookSend = ff.notebook && todo.length && (isOwner || (me.is_admin && sub.teacher_id !== me.id)); %>
          <form method="post" action="<%= ff.notebook ? '/s/' + sub.id + '/submit-book' : '/notes/submit-many' %>" data-busy="กำลังส่งบันทึก">
            <input type="hidden" name="back" value="/s/<%= sub.id %>#notes">
            <div class="table-wrap"><table class="table">
              <thead><tr>
                <% if (!ff.notebook && isOwner && todo.length) { %><th><input type="checkbox" data-check-all="ids" aria-label="เลือกทั้งหมด"></th><% } %>
                <th>แผนที่</th><th>เรื่อง</th><th class="hide-sm">วันที่สอน</th><th>สถานะ</th><th></th>
              </tr></thead>
              <tbody>
              <% for (const n of notes) { const can = isOwner && (n.status === 'draft' || n.status === 'returned'); %>
                <tr>
                  <% if (!ff.notebook && isOwner && todo.length) { %><td><% if (can) { %><input type="checkbox" name="ids" value="<%= n.id %>" aria-label="เลือก<%= planrange.label(n.plan_no) %>"><% } %></td><% } %>
                  <td class="nowrap"><b><%= planrange.short(n.plan_no) %></b></td>
                  <td><%= n.topic || (n.note_mode === 'file' ? 'แนบไฟล์' : '-') %>
                    <% const back = noteReturns.get(n.id); if (back != null) { const keep = back.startsWith(bookKeep); %>
                      <div class="small" style="margin-top:4px"><span class="badge <%= keep ? 'badge-gray' : 'badge-red' %>"><%= keep ? 'ไม่ต้องแก้' : 'ต้องแก้' %></span> <% if (!keep) { %><span class="muted"><%= back %></span><% } %></div>
                    <% } %></td>
                  <td class="hide-sm nowrap"><%= util.thaiDate(n.teach_date, true) %></td>
                  <td><%- include('partials/status', { s: n }) %></td>
                  <td class="right"><a class="btn btn-sm btn-ghost" href="/s/<%= n.id %><%= ff.notebook && can ? '/edit' : '' %>"><%= ff.notebook && can ? 'แก้ไข' : 'เปิด' %></a></td>
                </tr>
              <% } %>
              </tbody>
            </table></div>
            <% if (bookSend) { const gapText = planGaps.length ? 'ยังไม่มีบันทึกของแผนที่ ' + planGaps.slice(0, 10).join(' ') + (planGaps.length > 10 ? ' และอื่น ๆ' : '') : ''; %>
              <% if (gapText) { %><div class="alert alert-warn" style="margin-top:10px"><%- icon('note') %><span>เลขแผนข้าม <b><%= gapText %></b> ถ้าลืมเขียน กด เขียนบันทึกหลังแผน ก่อนส่ง ถ้าไม่ได้สอนแผนนั้นส่งได้เลย</span></div><% } %>
              <div class="btn-row" style="margin-top:10px">
                <button class="btn btn-primary btn-lg" type="submit" data-confirm="<%= (isOwner ? 'ส่งบันทึกหลังแผนทั้งเล่ม ' + todo.length + ' แผ่น ให้ผู้ลงความเห็น' : 'ส่งบันทึกหลังแผนทั้งเล่มแทน ' + sub.teacher_name + ' ระบบจะบันทึกว่าผู้ดูแลระบบส่งแทน') + (gapText ? '\nเลขแผนข้าม ' + gapText : '') %>" data-ok-label="ส่งทั้งเล่ม"<%- isOwner ? ' data-need-sig' : '' %>><%- icon('send', 20) %> <%= isOwner ? 'ส่งทั้งเล่ม' : 'ส่งทั้งเล่มแทนครู' %> (<%= todo.length %> แผ่น)</button>
                <small class="muted">ส่งทุกแผ่นที่เป็นร่างหรือรอแก้ไขในครั้งเดียว</small>
              </div>
            <% } else if (!ff.notebook && isOwner && todo.length) { %>
              <div class="btn-row" style="margin-top:10px">
                <button class="btn btn-primary" type="submit" data-need-checked="ids" data-confirm="ส่งบันทึกหลังแผนที่เลือกทั้งหมดให้ผู้ลงความเห็น" data-ok-label="ส่งทั้งหมด" data-need-sig><%- icon('send', 18) %> ส่งบันทึกที่เลือก (<span data-checked-count="ids">0</span>)</button>
                <small class="muted">ร่างหรือรอแก้ไข <%= todo.length %> ฉบับ</small>
              </div>
            <% } %>
          </form>
          <% if (bookPull) { %>
            <form method="post" action="/s/<%= sub.id %>/withdraw-book" class="btn-row" style="margin-top:10px"
              data-confirm="ดึงบันทึกหลังแผนกลับทั้งเล่ม <%= bookPull %> แผ่น ผู้ตรวจจะไม่เห็นจนกว่าคุณจะกดส่งทั้งเล่มอีกครั้ง" data-ok-label="ดึงกลับทั้งเล่ม">
              <button class="btn btn-ghost" type="submit"><%- icon('undo', 18) %> ดึงกลับทั้งเล่ม (<%= bookPull %> แผ่น)</button>
              <small class="muted">ลืมแผ่นไหน หรืออยากแก้ ดึงกลับได้ก่อนผู้ตรวจลงนาม</small>
            </form>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </div>

  <div>
    <% if (!isNote || current.length) { %>
      <div class="card">
        <h3><%= isNote ? 'ไฟล์บันทึกหรือไฟล์ประกอบ' : 'ไฟล์ที่ส่ง' %></h3>
        <% if (!current.length && !sub.link_url) { %><div class="muted">ยังไม่มีไฟล์</div><% } %>
        <ul class="file-list">
          <% for (const f of current) { %>
            <li>
              <%- icon('file', 20) %>
              <span class="fname"><%= f.original_name %><br><small class="muted"><%= util.fileSize(f.size) %></small></span>
              <% if (/^(application\/pdf|image\/)/.test(f.mime)) { %><button type="button" class="btn btn-sm btn-primary" data-view-file="/f/<%= f.id %>" data-type="<%= /pdf/.test(f.mime) ? 'pdf' : 'image' %>" data-name="<%= f.original_name %>">เปิดดู</button><% } %>
              <a class="btn btn-sm btn-ghost" href="/f/<%= f.id %>?dl=1">ดาวน์โหลด</a>
            </li>
          <% } %>
        </ul>
        <% const mainFiles = current.filter((f) => f.kind === 'main'); %>
        <% if (canCutPages && mainFiles.length === 1 && /pdf/.test(mainFiles[0].mime)) { %>
          <%# ตัดหน้าไฟล์ (ฟังก์ชันเสริม cutpages): เห็นทุกหน้า พิมพ์เลขหน้าหรือกดที่ภาพ ทำไฟล์ใหม่ในเบราว์เซอร์แล้วส่งเข้าระบบ %>
          <div class="add-cover">
            <button type="button" class="btn btn-sm btn-primary" data-cut-open="cut-dlg"><%- icon('edit', 16) %> <%= canMovePages && canInsertPages ? 'ตัด ย้าย หรือแทรกหน้าแทนครู' : canMovePages ? 'ตัดหรือย้ายหน้าแทนครู' : canInsertPages ? 'ตัดหรือแทรกหน้าแทนครู' : 'ตัดหน้าไฟล์แทนครู' %></button>
            <small class="muted"><%= canMovePages && canInsertPages ? 'ลบหน้าที่เกิน ย้ายหน้าที่วางผิดที่ หรือแทรกไฟล์ PDF ใหม่' : canMovePages ? 'ลบหน้าที่เกินหรือย้ายหน้าที่วางผิดที่' : canInsertPages ? 'ลบหน้าที่เกินหรือแทรกไฟล์ PDF ใหม่' : 'ลบหน้าที่เกินหรือส่งผิดตามเลขหน้า' %> ไฟล์เดิมเก็บไว้ ผู้ตรวจไม่ต้องลงนามใหม่</small>
          </div>
          <dialog class="modal front-dlg" id="cut-dlg" data-action="/s/<%= sub.id %>/cutpages" data-move-action="/s/<%= sub.id %>/movepages" data-insert-action="/s/<%= sub.id %>/insertpages" data-file="/f/<%= mainFiles[0].id %>/raw" data-from="<%= mainFiles[0].id %>" data-library="<%= ff.library ? '1' : '' %>" data-frontcheck="<%= ff.frontcheck ? '1' : '' %>" data-code="<%= sub.subject_code %>">
            <h3><%= canMovePages && canInsertPages ? 'ตัด ย้าย หรือแทรกหน้า' : canMovePages ? 'ตัดหรือย้ายหน้า' : canInsertPages ? 'ตัดหรือแทรกหน้า' : 'ตัดหน้าไฟล์' %> <%= sub.subject_code %></h3>
            <% if (canMovePages || canInsertPages) { %>
              <div class="cut-tabs" role="tablist">
                <button type="button" class="on" role="tab" aria-selected="true" data-cut-mode="cut">ลบหน้า</button>
                <% if (canMovePages) { %><button type="button" role="tab" aria-selected="false" data-cut-mode="move">ย้ายหน้า</button><% } %>
                <% if (canInsertPages) { %><button type="button" role="tab" aria-selected="false" data-cut-mode="insert">แทรกไฟล์</button><% } %>
              </div>
            <% } %>
            <p class="muted small" data-cut-info>กำลังเปิดไฟล์</p>
            <p class="front-step"><b>1</b> <span data-cut-step>พิมพ์เลขหน้าที่จะลบ</span></p>
            <% if (canInsertPages) { %>
              <div class="cut-input" data-insert-block hidden>
                <label class="btn btn-sm btn-primary"><%- icon('plus', 16) %> เลือกไฟล์ PDF<input type="file" accept=".pdf,application/pdf" hidden data-insert-file></label>
                <span class="muted small" data-insert-name>ยังไม่ได้เลือกไฟล์</span>
              </div>
            <% } %>
            <div class="cut-input" data-cut-row>
              <input type="text" autocomplete="off" data-cut-text aria-label="เลขหน้า">
              <span class="muted small" data-cut-hint>เช่น 1-18 หรือ 1-18, 25 หรือกดที่ภาพด้านล่างก็ได้</span>
            </div>
            <% if (canMovePages || canInsertPages) { %>
              <div data-move-block hidden>
                <p class="front-step"><b>2</b> <span data-move-to-label>ย้ายไปไว้</span></p>
                <div class="move-to">
                  <label><input type="radio" name="move_to" value="last" checked> ท้ายเล่ม</label>
                  <label><input type="radio" name="move_to" value="first"> หน้าแรก</label>
                  <label><input type="radio" name="move_to" value="after"> หลังหน้า</label>
                  <input type="text" inputmode="numeric" autocomplete="off" data-move-after aria-label="เลขหน้าปลายทาง">
                </div>
                <p class="front-step"><b>3</b> ดูผลก่อนบันทึก</p>
                <div class="move-preview" data-move-preview></div>
              </div>
            <% } %>
            <p class="front-step"><b data-cut-gallery-n>2</b> <span data-cut-gallery>ดูให้แน่ใจว่าถูกหน้า</span></p>
            <div class="front-pages cut-pages" data-cut-pages></div>
            <p class="front-sum" data-cut-sum></p>
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost btn-lg" data-cut-cancel>ยกเลิก</button>
              <button type="button" class="btn btn-primary btn-lg" data-cut-ok>ลบหน้าที่เลือก</button>
            </div>
          </dialog>
        <% } %>
        <% const mainPdf = (canAddCover || canFrontPages) && current.find((f) => f.kind === 'main' && /pdf/.test(f.mime)); %>
        <% if (mainPdf && canFrontPages) { %>
          <%# เปลี่ยนปก (ฟังก์ชันเสริม coverpdf): ดูภาพหน้าแรก ๆ ติ๊กหน้าที่จะลบ แล้วต่อปกใหม่ ทำในเบราว์เซอร์แล้วส่งเป็นไฟล์ใหม่ทางเดียวกับปุ่มเพิ่มหน้าปก %>
          <div class="add-cover">
            <button type="button" class="btn btn-sm btn-primary" data-front-open="front-dlg"><%- icon('edit', 16) %> <%= isOwner ? 'เปลี่ยนปก' : 'เปลี่ยนปกแทนครู' %></button>
            <small class="muted">ดูหน้าแรก ๆ ของไฟล์ ติ๊กหน้าที่จะลบ แล้วต่อปกใหม่<%= drawnBook ? ' หรือปกที่ระบบวาด' : '' %> ผู้ตรวจไม่ต้องลงนามใหม่</small>
          </div>
          <dialog class="modal front-dlg" id="front-dlg" data-action="/s/<%= sub.id %>/cover" data-file="/f/<%= mainPdf.id %>/raw" data-name="<%= mainPdf.original_name %>" data-library="<%= ff.library ? '1' : '' %>" data-frontcheck="<%= ff.frontcheck ? '1' : '' %>" data-code="<%= sub.subject_code %>">
            <h3>เปลี่ยนปก <%= sub.subject_code %></h3>
            <p class="front-step"><b>1</b> ติ๊กหน้าที่จะลบ <span class="muted small">กดที่ภาพหน้าที่ไม่ต้องการ</span></p>
            <div class="front-pages" data-front-pages><span class="muted small">กำลังเปิดไฟล์</span></div>
            <p class="front-step"><b>2</b> ปกใหม่</p>
            <div class="front-opts">
              <label><input type="radio" name="front_new" value="none"<%= drawnBook ? '' : ' checked' %>> ไม่ต่อปกใหม่</label>
              <% if (drawnBook) { %><label><input type="radio" name="front_new" value="drawn" checked> ปกที่ระบบวาด แบบเดียวกับคลังงาน</label><% } %>
              <label><input type="radio" name="front_new" value="file"> ไฟล์ปก PDF <span class="muted small" data-front-fname>กดเพื่อเลือกไฟล์</span><input type="file" accept=".pdf,application/pdf" hidden data-front-file></label>
            </div>
            <% if (drawnBook) { %><div class="front-drawn" data-front-drawn><%- include('partials/lib_cover', { b: drawnBook, logoUrl: logoBig }) %></div><% } %>
            <p class="front-sum" data-front-sum></p>
            <div class="modal-actions">
              <button type="button" class="btn btn-ghost btn-lg" data-front-cancel>ยกเลิก</button>
              <button type="button" class="btn btn-primary btn-lg" data-front-ok>บันทึก</button>
            </div>
          </dialog>
        <% } %>
        <% if (mainPdf && canAddCover) { %>
          <form class="add-cover" method="post" action="/s/<%= sub.id %>/cover" data-add-cover data-file="/f/<%= mainPdf.id %>/raw" data-name="<%= mainPdf.original_name %>" data-library="<%= ff.library ? '1' : '' %>" data-frontcheck="<%= ff.frontcheck ? '1' : '' %>" data-code="<%= sub.subject_code %>">
            <label class="btn btn-sm btn-primary"><%- icon('plus', 16) %> <%= isOwner ? 'เพิ่มหน้าปก' : 'เพิ่มหน้าปกแทนครู' %><input type="file" accept=".pdf,application/pdf" hidden data-cover-file></label>
            <small class="muted">ลืมใส่ปก เลือกไฟล์ปก PDF ระบบต่อไว้หน้าแรกของไฟล์เดิมให้ ไม่ต้องส่งใหม่ ผู้ตรวจไม่ต้องลงนามใหม่</small>
          </form>
        <% } %>
        <% if (old.length) { %>
          <details style="margin-top:8px"><summary class="muted small" style="cursor:pointer">ไฟล์รุ่นก่อนแก้ไข <%= old.length %> ไฟล์</summary>
            <ul class="file-list"><% for (const f of old) { %><li class="old"><span class="fname"><%= f.original_name %> <small class="muted"><%= util.thaiDate(f.uploaded_at, true) %></small></span><a class="btn btn-sm btn-ghost" href="/f/<%= f.id %>?dl=1">ดาวน์โหลด</a><% if (canOldFile && f.kind === 'main') { %><%# ใช้ไฟล์รุ่นก่อน (ฟังก์ชันเสริม oldfile) ไฟล์ PDF เบราว์เซอร์ทำรูปปกในคลังจากไฟล์นี้ส่งไปด้วย %><% const ofText = 'กลับไปใช้ไฟล์ ' + f.original_name + ' เป็นไฟล์ที่ส่ง ใช่ไหม\nไฟล์ที่ใช้อยู่ตอนนี้เก็บไว้ในไฟล์รุ่นก่อนแก้ไข ไม่ลบไฟล์ใด ผู้ตรวจไม่ต้องลงนามใหม่'; const ofThumb = ff.library && /pdf/.test(f.mime); %><form method="post" action="/s/<%= sub.id %>/oldfile/<%= f.id %>"<% if (ofThumb) { %> data-old-file="/f/<%= f.id %>/raw" data-text="<%= ofText %>"<% } else { %> data-confirm="<%= ofText %>" data-ok-label="ใช้ไฟล์นี้"<% } %>><button class="btn btn-sm btn-primary" type="<%= ofThumb ? 'button' : 'submit' %>"><%= isOwner ? 'ใช้ไฟล์นี้' : 'ใช้ไฟล์นี้แทนครู' %></button></form><% } %></li><% } %></ul>
          </details>
        <% } %>
      </div>
    <% } %>
    <% if (!isNote) { %>
      <div class="card">
        <h3><%= sub.doc_type === 'plan' ? 'คู่มือรายวิชานี้' : 'แผนของวิชานี้' %></h3>
        <% if (sibling) { %>
          <%- include('partials/status', { s: sibling }) %> <a class="btn btn-sm btn-ghost" href="/s/<%= sibling.id %>">เปิดดู</a>
        <% } else { %>
          <span class="muted">ยังไม่ได้ส่ง</span>
          <% if (isOwner && (sub.doc_type === 'plan' || canPlan)) { %><a class="btn btn-sm btn-primary" href="/works/new?type=<%= sub.doc_type === 'plan' ? 'manual' : 'plan' %>&from=<%= sub.id %>">ส่งเลย</a><% } else if (isOwner) { %><div class="hint">ส่งแผนเฉพาะวิชาหลัก วิชานี้ส่งเฉพาะคู่มือ</div><% } %>
        <% } %>
      </div>
    <% } %>

    <div class="card">
      <h3>ประวัติ</h3>
      <% if (sigBlank) { %>
        <div class="resign-box" id="sigconfirm">
          <div class="small muted"><%= sigBlank.proxy ? 'ผู้ดูแลระบบส่งงานนี้แทนคุณ ตรวจไฟล์และรายละเอียดแล้วกดยืนยัน ลายเซ็นของคุณจะอยู่ในบันทึกข้อความ' : 'งานนี้ส่งไปตอนยังไม่มีลายเซ็น บันทึกข้อความจึงไม่มีลายเซ็นของคุณ' %></div>
          <% if (me.signature) { %>
          <div class="btn-row"><span class="sig-box sig-old"><img src="<%= me.signature %>" alt="ลายเซ็นของคุณ"></span>
            <form method="post" action="/s/<%= sub.id %>/sigfill" data-confirm="<%= sigBlank.proxy ? 'ยืนยันว่าคุณตรวจงานที่ผู้ดูแลระบบส่งแทนแล้ว และใส่ลายเซ็นของคุณในงานนี้ ใช่ไหม ประวัติของงานจะบันทึกว่าคุณยืนยันแล้ว' : 'ใส่ลายเซ็นในข้อมูลส่วนตัวของคุณในงานนี้ ใช่ไหม ไม่ต้องส่งงานใหม่ ผู้ตรวจไม่ต้องลงนามใหม่' %>" data-ok-label="<%= sigBlank.proxy ? 'ยืนยัน' : 'ใส่ลายเซ็น' %>"><button class="btn btn-sm btn-primary" type="submit"><%= sigBlank.proxy ? 'ยืนยันงานนี้และใส่ลายเซ็น' : 'ใส่ลายเซ็นของฉันในงานนี้' %></button></form></div>
          <% } else { %>
          <a class="btn btn-sm btn-primary" href="/profile">เซ็นชื่อในหน้าข้อมูลส่วนตัว</a>
          <% } %>
        </div>
      <% } %>
      <% if (oldSig) { %>
        <div class="resign-box">
          <div class="small muted">คุณลงนามงานนี้ด้วยลายเซ็นเดิม</div>
          <div class="btn-row"><span class="sig-box sig-old"><img src="<%= oldSig %>" alt="ลายเซ็นเดิม"></span>
            <form method="post" action="/s/<%= sub.id %>/resign" data-confirm="ใช้ลายเซ็นปัจจุบันในข้อมูลส่วนตัวแทนลายเซ็นเดิมในงานนี้ ใช่ไหม เอกสารที่พิมพ์จากนี้จะเป็นลายเซ็นใหม่" data-ok-label="ใช้ลายเซ็นใหม่"><button class="btn btn-sm" type="submit">ใช้ลายเซ็นใหม่ของฉันในงานนี้</button></form></div>
        </div>
      <% } %>
      <% if (!reviews.length) { %><div class="muted">ยังไม่มีความเคลื่อนไหว</div><% } %>
      <ul class="timeline">
        <% for (const r of [...reviews].reverse()) { %>
          <li class="<%= r.action %>">
            <div><b><%= r.user_name || 'ระบบ' %></b> <span class="muted"><%= r.step_label %></span></div>
            <div><%= wf.ACTION_LABELS[r.action] %><%= r.score_max ? ' คะแนน ' + r.score_total + '/' + r.score_max : '' %></div>
            <div class="when"><%= util.thaiDateTime(r.created_at) %></div>
            <% if (r.comment) { %><div class="comment"><%= r.comment %></div><% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</div>
<%- include('partials/bottom') %>
