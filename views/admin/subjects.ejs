<%- include('../partials/top') %>
<div class="narrow" style="max-width:900px">
  <div class="page-head">
    <div><h1>รายวิชา</h1><div class="sub">ไม่บังคับ ถ้าใส่ไว้ ครูพิมพ์รหัสวิชาแล้วชื่อวิชาและระดับชั้นจะขึ้นเอง</div></div>
    <div class="actions"><a class="btn btn-ghost" href="/admin">กลับ</a></div>
  </div>
  <% if (result) { %>
    <div class="alert <%= result.errors.length ? 'alert-warn' : 'alert-success' %>">บันทึก <%= result.saved %> วิชา
      <% if (result.errors.length) { %><ul><% for (const e of result.errors) { %><li><%= e %></li><% } %></ul><% } %></div>
  <% } %>
  <form class="card" method="post" action="/admin/subjects">
    <div class="field">
      <label for="data">วางจาก Excel: รหัสวิชา ชื่อวิชา กลุ่มสาระ ระดับชั้น</label>
      <textarea id="data" name="data" style="min-height:180px;font-family:Consolas,monospace" placeholder="ว30203	ฟิสิกส์เพิ่มเติม 3	วิทยาศาสตร์	ม.5"></textarea>
      <div class="hint">รหัสวิชาที่ซ้ำของเดิมจะถูกแทนที่ด้วยข้อมูลใหม่</div>
    </div>
    <button class="btn btn-primary" type="submit" data-confirm="บันทึกรายวิชาที่วางไว้">บันทึก</button>
  </form>
  <div class="card">
    <div class="card-head"><h3><%= rows.length %> วิชา</h3>
      <% if (rows.length) { %><div class="actions"><form method="post" action="/admin/subjects/clear" class="inline-form"><button class="btn btn-sm btn-ghost" type="submit" data-danger="1" data-confirm="ล้างรายการรายวิชาทั้งหมด
งานที่ครูส่งแล้วไม่ได้รับผลกระทบ" data-ok-label="ล้าง">ล้างทั้งหมด</button></form></div><% } %>
    </div>
    <% if (rows.length) { %>
      <div class="table-wrap"><table class="table">
        <thead><tr><th>รหัส</th><th>ชื่อวิชา</th><th>กลุ่มสาระ</th><th>ชั้น</th></tr></thead>
        <tbody><% for (const s of rows) { %><tr><td><%= s.code %></td><td><%= s.name %></td><td><%= s.dept_name || '-' %></td><td><%= s.grade %></td></tr><% } %></tbody>
      </table></div>
    <% } %>
  </div>
</div>
<%- include('../partials/bottom') %>
