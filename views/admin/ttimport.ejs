<%- include('../partials/top') %>
<div class="narrow" style="max-width:1000px">
  <div class="page-head">
    <div>
      <h1>นำเข้ารายวิชาจากตารางสอน</h1>
      <div class="sub">ดึงข้อมูลว่าครูแต่ละคนสอนวิชาอะไร จากโปรแกรมจัดตารางสอน ใช้ได้แม้ตารางยังจัดไม่เสร็จ</div>
    </div>
    <div class="actions"><a class="btn btn-ghost" href="/admin"><%- icon('back', 18) %> กลับ</a></div>
  </div>

  <% if (!data) { %>
    <form class="card" method="post" action="/admin/teach-import/preview" enctype="multipart/form-data" data-busy="กำลังอ่านไฟล์">
      <h2>ขั้นที่ 1 เลือกไฟล์งานของภาคเรียนนั้น</h2>
      <ol class="muted">
        <li>เปิดโฟลเดอร์ของโปรแกรมจัดตารางสอน แล้วเข้าโฟลเดอร์ <b>ข้อมูลตารางสอน</b></li>
        <li>เข้าโฟลเดอร์ของภาคเรียนที่ต้องการ เช่น ตารางสอน ภาคเรียน2-2569</li>
        <li>เลือกไฟล์ <b>งานล่าสุด.json</b> (ถ้าระบบส่งแผนอยู่คนละเครื่อง คัดลอกไฟล์นี้ใส่แฟลชไดรฟ์มาได้)</li>
      </ol>
      <div class="field">
        <input type="file" name="ttfile" accept=".json,application/json" required>
      </div>
      <button class="btn btn-primary" type="submit"><%- icon('search', 18) %> อ่านไฟล์และจับคู่ชื่อครู</button>
      <p class="hint">ขั้นนี้ยังไม่บันทึกอะไร ระบบจะแสดงผลให้ตรวจก่อน ไฟล์ตารางสอนไม่ถูกแก้ไขและไม่ถูกเก็บไว้ในระบบ</p>
    </form>
  <% } else { const unmatched = data.rows.filter((r) => !r.userId).length; %>
    <form class="card flush" method="post" action="/admin/teach-import" data-confirm="นำเข้ารายวิชาที่ติ๊กไว้ ให้ครูที่เลือกชื่อไว้
รายวิชาเดิมของครูยังอยู่ครบ ระบบไม่ลบ และไม่ตั้งวิชาหลักให้" data-ok-label="นำเข้าเลย" data-busy="กำลังนำเข้า">
      <div class="card-head">
        <div>
          <h2>ขั้นที่ 2 ตรวจก่อนนำเข้า</h2>
          <div class="muted small">ไฟล์ <%= data.fileName %><%= data.school ? ' ' + data.school : '' %> ครู <%= data.rows.length %> คน รายวิชา <%= data.subjectCount %> วิชา<%= data.activities ? ' (ไม่รวมวิชากิจกรรม ' + data.activities + ' รายการ)' : '' %></div>
        </div>
        <div class="actions"><a class="btn btn-ghost btn-sm" href="/admin/teach-import">เลือกไฟล์ใหม่</a></div>
      </div>
      <div style="padding:12px 20px">
        <div class="btn-row">
          <label for="year">นำเข้าเป็นรายวิชาของปีการศึกษา</label>
          <input type="number" id="year" name="year" value="<%= year %>" style="max-width:110px">
          <label for="semester">ภาคเรียนที่</label>
          <input type="number" id="semester" name="semester" value="<%= semester %>" min="1" max="3" style="max-width:80px">
        </div>
        <% if (String(year) !== String(settings.academic_year) || String(semester) !== String(settings.semester)) { %>
          <div class="alert alert-warn" style="margin-top:10px"><%- icon('clock') %><span>ไฟล์นี้เป็นภาคเรียน <%= semester %>/<%= year %> แต่ระบบตั้งภาคเรียนปัจจุบันไว้ที่ <%= settings.semester %>/<%= settings.academic_year %> ครูจะเห็นรายวิชาเมื่อถึงภาคเรียนนั้น</span></div>
        <% } %>
        <% if (unmatched) { %>
          <div class="alert alert-warn" style="margin-top:10px"><%- icon('users') %><span>มีครู <%= unmatched %> คนที่ระบบหาชื่อในระบบส่งแผนไม่เจอ อยู่ด้านบนสุดของตาราง เลือกชื่อให้ถูกคน หรือปล่อยเป็น ไม่นำเข้า</span></div>
        <% } else { %>
          <div class="alert alert-success" style="margin-top:10px"><%- icon('ok') %><span>จับคู่ชื่อครูได้ครบทุกคน</span></div>
        <% } %>
      </div>
      <input type="hidden" name="n" value="<%= data.rows.length %>">
      <div class="table-wrap"><table class="table">
        <thead><tr><th style="width:24%">ชื่อในตารางสอน</th><th style="width:28%">ครูในระบบส่งแผน</th><th>วิชาที่สอน (เอาติ๊กออกถ้าไม่ต้องการ)</th></tr></thead>
        <tbody>
          <% data.rows.forEach((r, i) => { %>
            <tr>
              <td><b><%= r.name %></b><br><span class="badge <%= r.userId ? 'badge-green' : 'badge-amber' %>"><%= r.userId ? 'จับคู่ได้' : 'ยังไม่ได้เลือก' %></span></td>
              <td>
                <select name="map_<%= i %>" aria-label="ครูในระบบสำหรับ <%= r.name %>">
                  <option value="">ไม่นำเข้า</option>
                  <% for (const u of users) { %><option value="<%= u.id %>" <%= u.id === r.userId ? 'selected' : '' %>><%= u.full_name %><%= u.dept_name ? ' (' + u.dept_name + ')' : '' %></option><% } %>
                </select>
              </td>
              <td>
                <input type="hidden" name="subj_<%= i %>" value="<%= JSON.stringify(r.subjects) %>">
                <div class="checks">
                  <% for (const s of r.subjects) { %>
                    <label class="check"><input type="checkbox" name="pick_<%= i %>" value="<%= s.code %>" checked> <b><%= s.code %></b> <%= s.name %> <span class="muted"><%= s.grade %></span></label>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <div style="padding:16px 20px;border-top:1px solid var(--line)">
        <button class="btn btn-primary btn-lg" type="submit"><%- icon('download', 20) %> ขั้นที่ 3 นำเข้ารายวิชา</button>
        <p class="hint">ครูยังเพิ่มหรือเอาวิชาออกเองได้ในหน้ารายวิชาที่สอน และต้องเลือกวิชาหลักเอง</p>
      </div>
    </form>
  <% } %>
</div>
<%- include('../partials/bottom') %>
