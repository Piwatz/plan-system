<%- include('../partials/top') %>
<%
  const ICON = { mobilesheet: 'eye', chips: 'chips', notefile: 'file', counts: 'chart', quicksign: 'cards', voice: 'mic', filecheck: 'check', board: 'board', results: 'chart', pa: 'folder', qr: 'qr', prefs: 'moon', line: 'chat', teachlist: 'books', onemain: 'star', pdfonly: 'file', pdfmerge: 'copy', selfsign: 'edit', noactivity: 'close', ttimport: 'download', coverpreview: 'eye', namepick: 'users', pin: 'shield' };
%>
<div class="page-head">
  <div>
    <h1>ฟังก์ชันเสริม</h1>
    <div class="sub">เปิดหรือปิดได้ทีละอย่าง มีผลกับทุกคนทันที เฉพาะผู้ดูแลระบบเห็นหน้านี้ ทุกครั้งที่เปิดปิดจะถูกบันทึกไว้และลบไม่ได้</div>
  </div>
</div>

<div class="grid-3">
  <div style="display:flex;flex-direction:column;gap:12px">
    <% for (const f of list) { const blocked = f.needs && !ready[f.needs] && !f.on; %>
      <form class="feature<%= f.on ? ' on' : '' %>" method="post" action="/admin/features/<%= f.key %>"
        data-confirm="<%= f.on ? 'ปิด' : 'เปิด' %> <%= f.title %>
มีผลกับผู้ใช้ทุกคนทันที" data-ok-label="<%= f.on ? 'ปิด' : 'เปิด' %>" <%- f.on ? 'data-danger="1"' : '' %>>
        <input type="hidden" name="on" value="<%= f.on ? '0' : '1' %>">
        <span class="f-ic"><%- icon(ICON[f.key] || 'toggle', 24) %></span>
        <span class="f-body">
          <b><%= f.title %></b>
          <span class="muted"><%= f.desc %></span>
          <span class="tags"><span class="badge">ใช้โดย <%= f.who %></span></span>
          <% if (!f.on && f.offNote) { %><span class="f-off"><%= f.offNote %></span><% } %>
        </span>
        <button type="submit" class="switch" role="switch" aria-checked="<%= f.on %>" aria-label="<%= f.on ? 'ปิด' : 'เปิด' %> <%= f.title %>" <%= blocked ? 'disabled' : '' %>>
          <span class="track"></span><span><%= f.on ? 'เปิด' : 'ปิด' %></span>
        </button>
      </form>
    <% } %>
  </div>

  <div>
    <section class="card" id="phrases">
      <h2>ประโยคสำเร็จรูป</h2>
      <p class="muted small">ครูแตะเลือกในหน้าเขียนบันทึกหลังแผน ใส่ [ ] ตรงคำที่ครูต้องแก้เอง เช่น ตัวเลข หรือชื่อเรื่อง</p>
      <div class="btn-row" style="margin-bottom:10px">
        <% for (const g of groups) { %><a class="btn btn-sm <%= g.key === tab ? 'btn-primary' : 'btn-ghost' %>" href="/admin/features?tab=<%= g.key %>#phrases"><%= g.label %></a><% } %>
      </div>
      <form method="post" action="/admin/phrases" data-confirm="บันทึกประโยคสำเร็จรูปหมวดนี้">
        <input type="hidden" name="group" value="<%= tab %>">
        <div class="field">
          <label for="items">หนึ่งบรรทัดต่อหนึ่งประโยค</label>
          <textarea id="items" name="items" style="min-height:170px"><%= phrases.join('\n') %></textarea>
        </div>
        <button class="btn btn-primary" type="submit">บันทึกประโยค</button>
      </form>
    </section>

    <section class="card" id="line">
      <h2>เชื่อมต่อ LINE</h2>
      <p class="muted small">ใช้ LINE Official Account ของโรงเรียน (Messaging API) สร้างที่ developers.line.biz แล้วเชิญบัญชีเข้ากลุ่ม LINE ของผู้ตรวจ ระบบจะส่งสรุปงานที่รอลงนามเข้ากลุ่มทุกเช้า เครื่องที่ติดตั้งระบบต้องต่ออินเทอร์เน็ต</p>
      <form method="post" action="/admin/line" data-confirm="บันทึกการตั้งค่า LINE">
        <div class="field">
          <label for="line_token">Channel access token</label>
          <input type="password" id="line_token" name="line_token" autocomplete="off" placeholder="<%= settings.line_token ? 'บันทึกไว้แล้ว เว้นว่างไว้ถ้าไม่เปลี่ยน' : 'วางรหัสจาก LINE Developers' %>">
        </div>
        <div class="field">
          <label for="line_to">รหัสกลุ่ม LINE ที่จะส่งเข้า (Group ID)</label>
          <input type="text" id="line_to" name="line_to" value="<%= settings.line_to %>" placeholder="ขึ้นต้นด้วยตัว C">
        </div>
        <div class="field">
          <label for="line_time">เวลาส่งทุกวัน</label>
          <input type="time" id="line_time" name="line_time" value="<%= settings.line_time || '07:00' %>" style="max-width:160px">
        </div>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">บันทึก</button>
          <% if (lineReady) { %>
            <button class="btn btn-ghost" type="submit" formaction="/admin/line/test" data-confirm="ส่งข้อความทดลองเข้ากลุ่ม LINE ตอนนี้" data-ok-label="ส่งทดลอง">ส่งทดลอง</button>
            <button class="btn btn-ghost" type="submit" name="clear" value="1" data-confirm="ลบการเชื่อมต่อ LINE และปิดการส่งสรุปทุกเช้า" data-danger="1" data-ok-label="ลบ">ลบการเชื่อมต่อ</button>
          <% } %>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>ประวัติการเปิดปิด</h2>
      <% if (!log.length) { %><p class="muted">ยังไม่มีการเปลี่ยนแปลง</p><% } %>
      <ul class="feed">
        <% for (const l of log) { %>
          <li><span class="fdot <%= /^(ปิด|ถอด|ลบ)/.test(l.action) ? 'return' : 'approve' %>"></span>
            <span class="fbody"><b><%= l.action %></b><span><%= l.user_name %>  <%= util.thaiDateTime(l.at) %></span></span></li>
        <% } %>
      </ul>
      <p class="muted small" style="margin-top:12px"><%- icon('shield', 16) %> ประวัตินี้แก้ไขหรือลบไม่ได้ แม้แต่ผู้ดูแลระบบ</p>
    </section>
  </div>
</div>
<%- include('../partials/bottom') %>
