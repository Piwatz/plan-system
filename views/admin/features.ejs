<%- include('../partials/top') %>
<%
  const ICON = { mobilesheet: 'eye', chips: 'chips', notefile: 'file', counts: 'chart', quicksign: 'cards', voice: 'mic', filecheck: 'check', board: 'board', results: 'chart', pa: 'folder', qr: 'qr', prefs: 'moon', line: 'chat', teachlist: 'books', onemain: 'star', pdfonly: 'file', pdfmerge: 'copy', selfsign: 'edit', noactivity: 'close', ttimport: 'download', coverpreview: 'eye', namepick: 'users', pin: 'shield', namefix: 'edit', methodother: 'edit', notebook: 'books', notepdf: 'file', notesign: 'edit', homeact: 'check', library: 'books', libread: 'eye', coverswap: 'copy', coverstyle: 'books', libshow: 'eye', teachcards: 'books' };
%>
<div class="page-head">
  <div>
    <h1>ฟังก์ชันเสริม</h1>
    <div class="sub">เปิดหรือปิดได้ทีละอย่าง มีผลกับทุกคนทันที เฉพาะผู้ดูแลระบบเห็นหน้านี้ ทุกครั้งที่เปิดปิดจะถูกบันทึกไว้และลบไม่ได้</div>
  </div>
</div>

<div class="grid-3">
  <div style="display:flex;flex-direction:column;gap:12px">
    <% for (const f of list) { const blocked = f.needs && !ready[f.needs] && !f.on; %>
      <form class="feature<%= f.on ? ' on' : '' %>" id="f-<%= f.key %>" method="post" action="/admin/features/<%= f.key %>"
        data-confirm="<%= f.on ? 'ปิด' : 'เปิด' %> <%= f.title %>
มีผลกับผู้ใช้ทุกคนทันที" data-ok-label="<%= f.on ? 'ปิด' : 'เปิด' %>" <%- f.on ? 'data-danger="1"' : '' %>>
        <input type="hidden" name="on" value="<%= f.on ? '0' : '1' %>">
        <span class="f-ic"><%- icon(ICON[f.key] || 'toggle', 24) %></span>
        <span class="f-body">
          <b><%= f.title %></b>
          <span class="muted"><%= f.desc %></span>
          <span class="tags"><span class="badge">ใช้โดย <%= f.who %></span></span>
          <% if (!f.on && f.offNote) { %><span class="f-off"><%= f.offNote %></span><% } %>
        </span>
        <button type="submit" class="switch" role="switch" aria-checked="<%= f.on %>" aria-label="<%= f.on ? 'ปิด' : 'เปิด' %> <%= f.title %>" <%= blocked ? 'disabled' : '' %>>
          <span class="track"></span><span><%= f.on ? 'เปิด' : 'ปิด' %></span>
        </button>
      </form>
    <% } %>
  </div>

  <div>
    <% if (noteSign) { %>
      <section class="card" id="notesign">
        <h2>จัดหน้าลงนามบันทึกหลังแผน</h2>
        <p class="muted small">กด ดูตัวอย่าง เพื่อเปิดหน้าพิมพ์แบบนั้นจากเล่มจริงในระบบ ดูอย่างเดียว ยังไม่เปลี่ยนของใคร · มีผลตอนพิมพ์ทุกครั้ง ทั้งพิมพ์ทีละฉบับ ทั้งเล่ม และแฟ้ม PA เปลี่ยนเมื่อไรก็ได้ งานที่ลงนามแล้วไม่ต้องลงนามใหม่ ถ้ามีแผ่นใดใช้หน้ารวมลงนาม ระบบใส่หน้ารวมไว้หน้าแรกของเล่ม ตารางแสดงครบทุกแผน</p>
        <form method="post" action="/admin/notesign" data-confirm="เปลี่ยนการจัดหน้าลงนามบันทึกหลังแผน มีผลกับการพิมพ์ครั้งต่อไปของทุกคน" data-ok-label="บันทึก">
          <% for (const [kind, head] of [['web', 'แผ่นที่ครูพิมพ์ในเว็บ'], ['pdf', 'แผ่น PDF ที่ครูแนบ']]) { %>
            <fieldset class="field" style="border:0;padding:0;margin:0 0 12px">
              <legend class="label" style="font-weight:700"><%= head %></legend>
              <% for (const o of noteSignOpts[kind]) { %>
                <div class="ns-opt">
                  <label class="check"><input type="radio" name="<%= kind %>" value="<%= o.key %>" <%= noteSign[kind] === o.key ? 'checked' : '' %>> <%= o.label %></label>
                  <a class="btn btn-sm btn-ghost" href="/admin/notesign/preview?<%= kind %>=<%= o.key %>" target="_blank" rel="noopener"><%- icon('eye', 16) %> ดูตัวอย่าง</a>
                </div>
              <% } %>
            </fieldset>
          <% } %>
          <button class="btn btn-primary" type="submit">บันทึกการจัดหน้า</button>
        </form>
      </section>
    <% } %>

    <% if (ff.library) { %>
      <section class="card" id="libview">
        <h2>มุมมองเริ่มต้นของคลังงาน</h2>
        <p class="muted small">แบบที่ทุกคนเห็นเมื่อเปิดคลังงานครั้งแรก ผู้ใช้กดสลับมุมมองเองได้ที่มุมขวาบนของหน้าคลัง เครื่องจะจำแบบที่เลือกไว้</p>
        <form method="post" action="/admin/libview" data-confirm="เปลี่ยนมุมมองเริ่มต้นของคลังงาน มีผลกับผู้ที่ยังไม่เคยสลับมุมมองเอง" data-ok-label="บันทึก">
          <div class="field">
            <label class="check"><input type="radio" name="view" value="" <%= !libView ? 'checked' : '' %>> ตามขนาดจอ จอคอมเป็นชั้นวาง มือถือเป็นรายการ</label>
            <% for (const v of libViews) { %>
              <label class="check"><input type="radio" name="view" value="<%= v.key %>" <%= libView === v.key ? 'checked' : '' %>> <%= v.label %> ทุกเครื่อง</label>
            <% } %>
          </div>
          <button class="btn btn-primary" type="submit">บันทึกมุมมอง</button>
        </form>
      </section>
    <% } %>

    <% if (ff.library && ff.libshow) { %>
      <section class="card" id="libshow">
        <h2>งานที่แสดงในคลังงาน</h2>
        <p class="muted small">ตั้งได้ 3 ชั้น ชั้นที่ละเอียดกว่าชนะ งานร่างไม่แสดงเสมอ การเปิดอ่านไฟล์ใช้สิทธิ์เดิม · ชั้นที่ 3 ซ่อนหรือแสดงทีละเล่ม ทำในหน้าคลังงาน เปิดปุ่ม เห็นเล่มที่ซ่อนอยู่</p>
        <% if (ff.readperm) { %><p style="margin:0 0 12px"><a class="btn btn-sm btn-ghost" href="/admin/readperm"><%- icon('lock', 16) %> ตั้งว่าใครเปิดอ่านเล่มของคนอื่นได้</a></p><% } %>
        <form method="post" action="/admin/libshow" data-confirm="บันทึกงานที่แสดงในคลังงาน มีผลกับทุกคนทันที" data-ok-label="บันทึก">
          <fieldset class="field" style="border:0;padding:0;margin:0 0 12px">
            <legend class="label" style="font-weight:700">1 ค่าหลักของทั้งโรงเรียน</legend>
            <% for (const m of showModes) { %>
              <label class="check ls-mode"><input type="radio" name="mode" value="<%= m.key %>" <%= showRule.mode === m.key ? 'checked' : '' %>> <span><b><%= m.label %></b><span class="muted small"><%= m.desc %></span></span></label>
            <% } %>
          </fieldset>
          <div class="field">
            <label class="label" for="ls-find" style="font-weight:700">2 ยกเว้นรายครู</label>
            <input id="ls-find" type="search" placeholder="ค้นหาชื่อครู" autocomplete="off" data-ls-find>
            <div class="ls-list">
              <% for (const t of showTeachers) { const v = showRule.teachers[t.id] || 'auto'; %>
                <div class="ls-row" data-ls-name="<%= t.full_name %> <%= t.dept_name || '' %>">
                  <span><%= t.full_name %><small class="muted"><%= t.dept_name || 'ไม่ระบุกลุ่มสาระ' %></small></span>
                  <span class="ls-seg" role="radiogroup" aria-label="<%= t.full_name %>">
                    <% for (const [k, label] of [['auto', 'ตามค่าหลัก'], ['show', 'แสดงทุกงาน'], ['hide', 'ซ่อน']]) { %>
                      <label class="ls-<%= k %>"><input type="radio" name="t_<%= t.id %>" value="<%= k %>" <%= v === k ? 'checked' : '' %>><span><%= label %></span></label>
                    <% } %>
                  </span>
                </div>
              <% } %>
            </div>
          </div>
          <button class="btn btn-primary" type="submit">บันทึกงานที่แสดง</button>
        </form>
        <script>(function(){var f=document.querySelector('[data-ls-find]');if(!f)return;f.addEventListener('input',function(){var v=f.value.trim();document.querySelectorAll('[data-ls-name]').forEach(function(r){r.hidden=v&&r.getAttribute('data-ls-name').indexOf(v)<0})})})();</script>
      </section>
    <% } %>

    <% if (ff.library && ff.coverstyle) { %>
      <section class="card" id="coverstyle">
        <h2>แบบปกที่ระบบวาด</h2>
        <p class="muted small">ใช้กับเล่มในคลังงานที่ไม่มีรูปปก และบันทึกหลังแผนทุกเล่ม สีแยกตามชนิดงาน ภาพตัวอย่างเป็นข้อมูลสมมติ เปลี่ยนเมื่อไรก็ได้ มีผลกับทุกคนทันที</p>
        <form method="post" action="/admin/coverstyle" data-confirm="เปลี่ยนแบบปกที่ระบบวาด มีผลกับคลังงานของทุกคนทันที" data-ok-label="บันทึก">
          <div class="cvs-pick">
            <% coverStyles.forEach((o, i) => { %>
              <label class="cvs-opt">
                <%- include('../partials/lib_cover', { b: { ...coverSample, kind: ['plan', 'manual', 'note', 'plan'][i], shelfLabel: ['แผนการจัดการเรียนรู้', 'คู่มือรายวิชา', 'บันทึกหลังแผน', 'แผนการจัดการเรียนรู้'][i] }, style: o.key }) %>
                <span class="check"><input type="radio" name="style" value="<%= o.key %>" <%= coverStyle === o.key ? 'checked' : '' %>> <%= o.label %></span>
              </label>
            <% }) %>
          </div>
          <button class="btn btn-primary" type="submit">บันทึกแบบปก</button>
        </form>
      </section>
    <% } %>

    <% if (ff.teachcards) { %>
      <section class="card" id="teachcards">
        <h2>แบบหน้ารายวิชาที่สอนบนมือถือ</h2>
        <p class="muted small">ใช้กับหน้ารายวิชาที่สอนเมื่อเปิดบนมือถือ จอคอมเป็นแบบเดิมเสมอ ภาพตัวอย่างเป็นข้อมูลสมมติ เปลี่ยนเมื่อไรก็ได้ มีผลกับทุกคนทันที</p>
        <form method="post" action="/admin/teachstyle" data-confirm="เปลี่ยนแบบหน้ารายวิชาที่สอนบนมือถือ มีผลกับทุกคนทันที" data-ok-label="บันทึก">
          <div class="tcs-pick">
            <% teachStyles.forEach((o) => { %>
              <label class="tcs-opt">
                <img src="/static/img/teachstyle-<%= o.key %>.jpg" alt="<%= o.label %>" width="250" height="400" loading="lazy">
                <span class="check"><input type="radio" name="teach_style" value="<%= o.key %>" <%= teachStyle === o.key ? 'checked' : '' %>> <%= o.label %></span>
              </label>
            <% }) %>
          </div>
          <button class="btn btn-primary" type="submit">บันทึกแบบหน้ารายวิชา</button>
        </form>
      </section>
    <% } %>

    <% if (ff.myshelf) { %>
      <section class="card" id="myshelf">
        <h2>แบบหน้างานของฉัน</h2>
        <p class="muted small">ใช้กับหน้างานของฉันของครูทุกคน ทั้งจอคอมและมือถือ ปกดึงจากคลังงาน เปลี่ยนเมื่อไรก็ได้ มีผลกับทุกคนทันที</p>
        <form method="post" action="/admin/mystyle" data-confirm="เปลี่ยนแบบหน้างานของฉัน มีผลกับทุกคนทันที" data-ok-label="บันทึก">
          <div class="field">
            <% for (const o of myStyles) { %>
              <label class="check"><input type="radio" name="my_style" value="<%= o.key %>" <%= myStyleNow === o.key ? 'checked' : '' %>> <%= o.label %></label>
            <% } %>
          </div>
          <button class="btn btn-primary" type="submit">บันทึกแบบหน้างานของฉัน</button>
        </form>
      </section>
    <% } %>

    <section class="card" id="phrases">
      <h2>ประโยคสำเร็จรูป</h2>
      <p class="muted small">ครูแตะเลือกในหน้าเขียนบันทึกหลังแผน ใส่ [ ] ตรงคำที่ครูต้องแก้เอง เช่น ตัวเลข หรือชื่อเรื่อง</p>
      <div class="btn-row" style="margin-bottom:10px">
        <% for (const g of groups) { %><a class="btn btn-sm <%= g.key === tab ? 'btn-primary' : 'btn-ghost' %>" href="/admin/features?tab=<%= g.key %>#phrases"><%= g.label %></a><% } %>
      </div>
      <form method="post" action="/admin/phrases" data-confirm="บันทึกประโยคสำเร็จรูปหมวดนี้">
        <input type="hidden" name="group" value="<%= tab %>">
        <div class="field">
          <label for="items">หนึ่งบรรทัดต่อหนึ่งประโยค</label>
          <textarea id="items" name="items" style="min-height:170px"><%= phrases.join('\n') %></textarea>
        </div>
        <button class="btn btn-primary" type="submit">บันทึกประโยค</button>
      </form>
    </section>

    <section class="card" id="line">
      <h2>เชื่อมต่อ LINE</h2>
      <p class="muted small">ใช้ LINE Official Account ของโรงเรียน (Messaging API) สร้างที่ developers.line.biz แล้วเชิญบัญชีเข้ากลุ่ม LINE ของผู้ตรวจ ระบบจะส่งสรุปงานที่รอลงนามเข้ากลุ่มทุกเช้า <%= cloud ? 'ข้อความอาจถึงช้ากว่าเวลาที่ตั้งไว้ไม่เกิน 5 นาที' : 'เครื่องที่ติดตั้งระบบต้องต่ออินเทอร์เน็ต' %></p>
      <form method="post" action="/admin/line" data-confirm="บันทึกการตั้งค่า LINE">
        <div class="field">
          <label for="line_token">Channel access token</label>
          <input type="password" id="line_token" name="line_token" autocomplete="off" placeholder="<%= settings.line_token_set ? 'บันทึกไว้แล้ว เว้นว่างไว้ถ้าไม่เปลี่ยน' : 'วางรหัสจาก LINE Developers' %>">
        </div>
        <div class="field">
          <label for="line_to">รหัสกลุ่ม LINE ที่จะส่งเข้า (Group ID)</label>
          <input type="text" id="line_to" name="line_to" value="<%= settings.line_to %>" placeholder="ขึ้นต้นด้วยตัว C">
        </div>
        <div class="field">
          <label for="line_time">เวลาส่งทุกวัน</label>
          <input type="time" id="line_time" name="line_time" value="<%= settings.line_time || '07:00' %>" style="max-width:160px">
        </div>
        <div class="btn-row">
          <button class="btn btn-primary" type="submit">บันทึก</button>
          <% if (lineReady) { %>
            <button class="btn btn-ghost" type="submit" formaction="/admin/line/test" data-confirm="ส่งข้อความทดลองเข้ากลุ่ม LINE ตอนนี้" data-ok-label="ส่งทดลอง">ส่งทดลอง</button>
            <button class="btn btn-ghost" type="submit" name="clear" value="1" data-confirm="ลบการเชื่อมต่อ LINE และปิดการส่งสรุปทุกเช้า" data-danger="1" data-ok-label="ลบ">ลบการเชื่อมต่อ</button>
          <% } %>
        </div>
      </form>
    </section>

    <section class="card" id="history">
      <h2>ประวัติการเปิดปิด</h2>
      <% if (!log.length) { %><p class="muted">ยังไม่มีการเปลี่ยนแปลง</p><% } %>
      <ul class="feed">
        <% for (const l of log) { %>
          <li><span class="fdot <%= /^(ปิด|ถอด|ลบ)/.test(l.action) ? 'return' : 'approve' %>"></span>
            <span class="fbody"><b><%= l.action %></b><span><%= l.user_name %>  <%= util.thaiDateTime(l.at) %></span></span></li>
        <% } %>
      </ul>
      <p class="muted small" style="margin-top:12px"><%- icon('shield', 16) %> ประวัตินี้แก้ไขหรือลบไม่ได้ แม้แต่ผู้ดูแลระบบ</p>
    </section>
  </div>
</div>
<%- include('../partials/bottom') %>
