<%- include('../partials/top') %>
<div class="page-head"><div><h1>ผู้ดูแลระบบ</h1><div class="sub">ตั้งค่าระบบให้ตรงกับโรงเรียน ทำตามลำดับ 1 ถึง 5 ครั้งแรกที่ติดตั้ง</div></div></div>

<% if (find) { %><%- include('../partials/adminfind') %><% } %>
<% if (warnings.length) { %>
  <div class="alert alert-warn"><b>สิ่งที่ยังต้องตั้งค่า</b><ul><% for (const w of warnings) { %><li><%= w %></li><% } %></ul></div>
<% } else { %>
  <div class="alert alert-success">กำหนดผู้ตรวจครบทุกระดับแล้ว</div>
<% } %>

<div class="grid admin-menu">
  <a class="stat" href="/admin/settings"><span class="icon"><%- icon('school', 24) %></span><span><b>1. ตั้งค่าโรงเรียน</b><br><span class="label">ชื่อโรงเรียน ตราโรงเรียน ภาคเรียน ช่วงเวลาเปิดรับส่ง</span></span></a>
  <a class="stat purple" href="/admin/departments"><span class="icon"><%- icon('board', 24) %></span><span><b>2. กลุ่มสาระ</b><br><span class="label"><%= counts.departments %> กลุ่มสาระ</span></span></a>
  <a class="stat green" href="/admin/users"><span class="icon"><%- icon('users', 24) %></span><span><b>3. รายชื่อครูและผู้ตรวจ</b><br><span class="label">ใช้งาน <%= counts.users %> คน เป็นครูผู้สอน <%= counts.teachers %> คน</span></span></a>
  <a class="stat amber" href="/admin/workflow"><span class="icon"><%- icon('flow', 24) %></span><span><b>4. ขั้นตอนการตรวจ</b><br><span class="label">ชื่อตำแหน่ง ระดับที่ใช้กับงานแต่ละชนิด ผู้ให้คะแนน</span></span></a>
  <a class="stat blue" href="/admin/rubric?type=plan"><span class="icon"><%- icon('star', 24) %></span><span><b>5. แบบประเมิน</b><br><span class="label">แผน <%= counts.rubricPlan %> ข้อ คู่มือรายวิชา <%= counts.rubricManual %> ข้อ</span></span></a>
  <a class="stat blue" href="/admin/features"><span class="icon"><%- icon('toggle', 24) %></span><span><b>ฟังก์ชันเสริม</b><br><span class="label">เปิดปิดฟังก์ชันใหม่ ประโยคสำเร็จรูป LINE และดูประวัติการเปิดปิด</span></span></a>
  <% if (ff.ttimport) { %><a class="stat green" href="/admin/teach-import"><span class="icon"><%- icon('download', 24) %></span><span><b>นำเข้ารายวิชาจากตารางสอน</b><br><span class="label">ดึงว่าครูแต่ละคนสอนวิชาอะไร จากโปรแกรมจัดตารางสอน</span></span></a><% } %>
  <% if (ff.reportsum) { %><a class="stat" href="/admin/report"><span class="icon"><%- icon('edit', 24) %></span><span><b>สรุปการส่งงานครู</b><br><span class="label">ตามจริง ฉบับรายงาน พิมพ์บันทึกข้อความ</span></span></a><% } %>
  <% if (ff.transfer) { %><a class="stat purple" href="/admin/transfer"><span class="icon"><%- icon('users', 24) %></span><span><b>โอนงานระหว่างครู</b><br><span class="label">ครูสอนแทนส่งไว้ ครูเจ้าของวิชากลับมารับช่วงต่อ</span></span></a><% } %>
  <% if (ff.library && ff.readperm) { %><a class="stat" href="/admin/readperm"><span class="icon"><%- icon('lock', 24) %></span><span><b>สิทธิ์อ่านงานในคลัง</b><br><span class="label">ตำแหน่งไหนอ่านเล่มของคนอื่นได้ หรือเห็นแค่ปก</span></span></a><% } %>
  <% if (ff.library && ff.libfeature) { %><a class="stat" href="/admin/libfeature"><span class="icon"><%- icon('star', 24) %></span><span><b>แถบคลังงานในหน้าแรก</b><br><span class="label">เลือกแบบแถบ และติ๊กงานเด่นขึ้นหน้าแรก</span></span></a><% } %>
  <% if (ff.homelayout && ff.homeorder) { %><a class="stat" href="/admin/homeorder"><span class="icon"><%- icon('rows', 24) %></span><span><b>ลำดับหน้าแรก</b><br><span class="label">ลากสลับกล่องบนหน้าแรก ซ่อนบางกล่องได้</span></span></a><% } %>
  <% if (ff.docnoreg) { %><a class="stat amber" href="/admin/docnoreg"><span class="icon"><%- icon('list', 24) %></span><span><b>ทะเบียนเลขบันทึกข้อความ</b><br><span class="label">เลขที่ครูกรอกในงาน เรียงตามเลขหรือแยกตามครู เลขซ้ำ งานที่ไม่มีเลข ส่งออก Excel</span></span></a><% } %>
  <a class="stat orange" href="/admin/subjects"><span class="icon"><%- icon('books', 24) %></span><span><b>รายวิชา (ไม่บังคับ)</b><br><span class="label"><%= counts.subjects %> วิชา ช่วยให้ครูพิมพ์รหัสวิชาแล้วชื่อขึ้นเอง</span></span></a>
</div>

<div class="grid-2" style="margin-top:18px">
  <div class="card" id="address">
    <h3>ที่อยู่สำหรับให้ครูเข้าใช้</h3>
<% if (cloud) { %>
    <p class="muted small">ครูเปิดเบราว์เซอร์จากที่ไหนก็ได้ที่มีอินเทอร์เน็ต แล้วพิมพ์ที่อยู่ด้านล่าง</p>
    <div style="font-size:1.15rem;overflow-wrap:anywhere"><b><%= webUrl %></b></div>
<% } else { %>
    <p class="muted small">ครูที่ต่อ Wi-Fi เดียวกับเครื่องนี้ เปิดเบราว์เซอร์แล้วพิมพ์ที่อยู่ด้านล่าง</p>
    <% if (addresses.length) { for (const a of addresses) { %><div style="font-size:1.15rem"><b>http://<%= a %>:<%= port %></b></div><% } } else { %><div class="muted">ไม่พบการเชื่อมต่อเครือข่าย</div><% } %>
<% } %>
  </div>
  <div class="card" id="backup">
    <h3>สำรองข้อมูล</h3>
<% const b = backupInfo; const where = fileStore === 'gdrive' ? 'ของ Google Drive โรงเรียน' : 'ในที่เก็บไฟล์ของระบบ'; %>
    <div class="bk-row"><span class="bk-dot <%= b.problem ? 'bad' : b.okAt ? 'ok' : 'wait' %>"></span><div><b>สำรองทุกคืน</b>
      <span><% if (b.problem && b.problem.kind === 'fail') { %>คืนล่าสุดไม่สำเร็จ <%= util.thaiDateTime(b.problem.at) %><% if (b.problem.msg) { %> สาเหตุ <%= b.problem.msg %><% } %><% } else if (b.okAt) { %>สำเร็จล่าสุด <%= util.thaiDateTime(b.okAt) %><% } else { %>ยังไม่มีบันทึกการสำรอง ระบบสำรองให้เองทุกคืนตอนตีสอง<% } %> เก็บ 30 คืนล่าสุด โฟลเดอร์ สำรองข้อมูล <%= where %></span></div></div>
<% if (ff.backupkeep) { %>
    <div class="bk-row"><span class="bk-dot <%= b.monthAt ? 'ok' : 'wait' %>"></span><div><b>สำรองรายเดือน เก็บถาวร</b>
      <span><% if (b.monthAt) { %>ฉบับวันที่ <%= util.thaiDate(b.monthAt, true) %> มีทั้งหมด <%= b.monthN %> ฉบับ<% } else { %>ระบบเก็บเองคืนแรกของเดือนที่สำรองสำเร็จ<% } %> โฟลเดอร์ สำรองรายเดือน</span></div></div>
    <div class="bk-row"><span class="bk-dot <%= b.termAt ? 'ok' : 'wait' %>"></span><div><b>สำรองปิดภาคเรียน เก็บถาวร</b>
      <span><% if (b.termAt) { %>ล่าสุดภาค <%= b.termLabel %> เมื่อ <%= util.thaiDateTime(b.termAt) %> มีทั้งหมด <%= b.termN %> ฉบับ<% } else { %>ยังไม่เคยเก็บ กดปุ่มด้านล่างตอนปิดภาคเรียน<% } %> โฟลเดอร์ สำรองปิดภาคเรียน</span></div></div>
<% } %>
    <div class="bk-btns">
      <a class="btn btn-primary" href="/admin/backup">ดาวน์โหลดสำรองฐานข้อมูล</a>
<% if (ff.trashbin) { %>
      <a class="btn" href="/admin/trash"><%- icon('undo', 18) %> ไฟล์ในถังขยะ กู้งานที่ลบผิด</a>
<% } %>
<% if (ff.backupkeep) { %>
      <form method="post" action="/admin/backup/term" data-confirm="เก็บสำรองข้อมูลฉบับปิดภาคเรียนที่ <%= b.term %> ไว้ถาวรในโฟลเดอร์ สำรองปิดภาคเรียน ใช่ไหม ระบบไม่ลบไฟล์นี้ทิ้ง กดซ้ำได้ จะได้อีกฉบับตามวันที่กด"><button class="btn" type="submit">เก็บสำรองฉบับปิดภาค <%= b.term %></button></form>
<% } %>
    </div>
<% if (fileStore === 'gdrive') { %>
    <div class="muted small" style="margin-top:8px">ไฟล์งานที่ครูส่งเก็บอยู่ใน Google Drive โรงเรียน โฟลเดอร์ ระบบส่งแผนการสอน ไม่อยู่ในไฟล์สำรอง</div>
<% } else { %>
    <div class="muted small" style="margin-top:8px">ไฟล์งานที่ครูส่งเก็บอยู่ในโฟลเดอร์ ไม่อยู่ในไฟล์สำรอง<br><code style="overflow-wrap:anywhere"><%= filesDir %></code></div>
<% } %>
    <div class="muted small" style="margin-top:6px">งานที่ส่งแล้วทั้งหมด <%= counts.submissions %> รายการ</div>
  </div>
<% if (accounts) { const a = accounts; const nLocked = a.failed.filter((f) => f.locked).length; %>
  <div class="card" id="accounts">
    <h3 class="acct-head">บัญชีผู้ใช้<% if (nLocked) { %> <span class="acct-chip">ถูกล็อก <%= nLocked %> คน</span><% } %></h3>
<% if (a.failed.length) { for (const f of a.failed) { %>
    <div class="bk-row acct-row"><span class="bk-dot bad"></span><div><b><%= f.full_name %></b>
      <span>ใส่รหัสผิด <%= f.count %> ครั้ง<% if (f.locked) { %> ล็อกถึง <%= f.untilText %> น.<% } else { %> ใน 10 นาทีที่ผ่านมา ยังไม่ล็อก<% } %></span></div>
      <form method="post" action="/admin/users/<%= f.id %>/unlock" data-confirm="<%= f.locked ? 'ปลดล็อกบัญชีของ ' + f.full_name + ' ใช่ไหม เข้าสู่ระบบได้ทันทีไม่ต้องรอ 10 นาที ถ้าไม่ใช่เจ้าของบัญชีลองเดารหัส ควรตั้งรหัสใหม่ให้ด้วย' : 'ล้างตัวนับรหัสผิดของ ' + f.full_name + ' ใช่ไหม' %>" data-ok-label="<%= f.locked ? 'ปลดล็อก' : 'ล้างตัวนับ' %>"><button class="btn btn-sm<%= f.locked ? ' btn-primary' : '' %>" type="submit"><%= f.locked ? 'ปลดล็อก' : 'ล้างตัวนับ' %></button></form></div>
<% } } else { %>
    <div class="bk-row"><span class="bk-dot ok"></span><div><b>ไม่มีบัญชีถูกล็อก</b><span>ชื่อที่ใส่รหัสผิดตั้งแต่ 5 ครั้งใน 10 นาที จะขึ้นที่นี่ พร้อมปุ่มปลดล็อก</span></div></div>
<% } %>
<% for (const [list, title] of [[a.never, 'ยังไม่เคยเข้าระบบ'], [a.oldPw, 'เข้าแล้ว แต่ยังไม่ได้เปลี่ยนรหัสที่ผู้ดูแลตั้งให้']]) { %>
    <details class="acct-list"<%= list === a.never && list.n && list.n <= 12 ? ' open' : '' %>><summary><%= title %> <%= list.n %> คน</summary>
<% if (list.n) { for (const g of list.groups) { %>
      <div class="acct-dept"><%= g.label %></div><div class="acct-names"><% g.users.forEach((u, i) => { %><a href="/admin/users/<%= u.id %>"><%= u.full_name %></a><% }) %></div>
<% } } else { %><div class="muted small">ไม่มี</div><% } %>
    </details>
<% } %>
  </div>
<% } %>
<% if (sigMissing) { const nWorks = sigMissing.reduce((a, r) => a + r.n, 0); %>
  <div class="card" id="sigmissing">
    <h3 class="acct-head">งานที่ยังไม่มีลายเซ็นครู<% if (sigMissing.length) { %> <span class="acct-chip"><%= sigMissing.length %> คน <%= nWorks %> งาน</span><% } %></h3>
<% if (sigMissing.length) { %>
<% for (const r of sigMissing) { %>
    <div class="bk-row acct-row"><span class="bk-dot<%= r.has_sig ? '' : ' bad' %>"></span><div><b><a href="/admin/users/<%= r.id %>"><%= r.full_name %></a></b>
      <span><%= r.dept || 'ไม่มีกลุ่มสาระ' %> · <%= r.n %> งาน · <%= r.has_sig ? (ff.sigconfirm && r.proxy_n === r.n ? 'มีลายเซ็นแล้ว งานที่ผู้ดูแลส่งแทน รอครูยืนยันในหน้างาน' : ff.sigfillauto ? 'มีลายเซ็นแล้ว ระบบใส่ให้เมื่อครูเปิดหน้าแรก' : 'มีลายเซ็นแล้ว รอครูกดใส่ในงาน') : 'ยังไม่มีลายเซ็น' %><%= ff.sigconfirm && r.proxy_n && r.proxy_n !== r.n ? ' · ผู้ดูแลส่งแทน ' + r.proxy_n + ' งาน รอครูยืนยัน' : '' %></span></div></div>
<% } %>
    <form method="post" action="/admin/sig-remind" style="margin-top:10px" data-confirm="ส่งแจ้งเตือนในระบบถึงครูทั้ง <%= sigMissing.length %> คน ให้เซ็นชื่อในหน้าข้อมูลส่วนตัว ใช่ไหม" data-ok-label="ส่งแจ้งเตือน"><button class="btn btn-primary" type="submit">ส่งแจ้งเตือนถึงครูทั้ง <%= sigMissing.length %> คน</button></form>
    <p class="muted small">ผู้ดูแลระบบใส่ลายเซ็นแทนครูไม่ได้ เพราะเป็นเอกสารราชการ ได้แค่ตามให้ครูเซ็นเอง ครูที่เซ็นแล้วหลุดจากรายชื่อเอง</p>
<% } else { %>
    <div class="bk-row"><span class="bk-dot ok"></span><div><b>ทุกงานที่ส่งแล้วมีลายเซ็นครู</b><span>ครูที่ส่งงานตอนยังไม่มีลายเซ็นจะขึ้นที่นี่ พร้อมปุ่มส่งแจ้งเตือน</span></div></div>
<% } %>
  </div>
<% } %>
<% if (front) { %>
  <div class="card" id="frontcheck">
    <h3 class="acct-head">งานที่หน้าแรกน่าจะไม่ใช่ปก<% if (front.bad.length) { %> <span class="acct-chip"><%= front.bad.length %> งาน</span><% } %></h3>
<% if (front.todo) { %>
    <div class="fc-scan" data-fc-scan>
      <div class="fc-scan-text" data-fc-text>มีงานเดิมที่ยังไม่ได้ตรวจหน้าแรก <%= front.todo %> งาน</div>
      <div class="fc-bar" data-fc-bar hidden><i></i></div>
      <button type="button" class="btn btn-primary btn-sm" data-fc-start data-ask="ให้เครื่องนี้เปิดไฟล์งานเดิม <%= front.todo %> งานทีละไฟล์เพื่อตรวจหน้าแรก ใช้เวลาสักครู่ ระหว่างตรวจอย่าปิดหน้านี้ ปิดแล้วกลับมาทำต่อได้">ตรวจหน้าแรกของงานเดิม</button>
      <button type="button" class="btn btn-ghost btn-sm" data-fc-stop hidden>หยุด</button>
    </div>
<% } %>
<% if (front.bad.length) { %>
<% for (const r of front.bad) { %>
    <div class="fc-row">
      <span class="fc-pg" data-fc-thumb="/f/<%= r.file %>/raw"></span>
      <div class="fc-t"><b><a href="/s/<%= r.id %>"><%= r.subject_code %> <%= r.subject_name %></a></b>
        <% if (r.front_check.includes('blank')) { %><span class="fc-tag blank">หน้าแรกเกือบว่าง</span><% } %><% if (r.front_check.includes('nocode')) { %><span class="fc-tag code">ไม่พบรหัส <%= r.subject_code %></span><% } %>
        <span class="fc-m"><%= r.teacher_name %> · <%= r.type_label %> · <%= r.status_text %></span></div>
      <div class="fc-acts">
        <a class="btn btn-primary btn-sm" href="/s/<%= r.id %><%= ff.coverpdf ? '?front=1' : '' %>"><%= ff.coverpdf ? 'เปลี่ยนปก' : 'เปิดงาน' %></a>
        <form method="post" action="/admin/frontcheck/<%= r.file %>/seen" data-confirm="หน้าแรกของ <%= r.subject_code %> ของ<%= r.teacher_name %> เป็นปกถูกแล้ว เอาออกจากรายการ ถ้าเปลี่ยนไฟล์ใหม่ ระบบตรวจไฟล์ใหม่อีกครั้ง" data-ok-label="ปกถูกแล้ว"><button class="btn btn-ghost btn-sm" type="submit">ปกถูกแล้ว</button></form>
      </div>
    </div>
<% } %>
    <p class="muted small">ระบบเดาจากหน้าแรกของไฟล์ เกือบว่าง คือแทบไม่มีตัวหนังสือ ไม่พบรหัส คือมีตัวหนังสือแต่ไม่มีรหัสวิชาของงาน กด เปลี่ยนปก แล้วติ๊กหน้าที่ผิดหรือต่อปกใหม่ ถ้าระบบเดาผิดกด ปกถูกแล้ว</p>
<% } else { %>
    <div class="bk-row"><span class="bk-dot ok"></span><div><b><%= front.todo ? 'งานที่ตรวจแล้วหน้าแรกเป็นปกทุกงาน' : 'หน้าแรกของทุกงานที่ส่งแล้วเป็นปก' %></b><span>ระบบตรวจหน้าแรกตอนครูกดส่ง งานที่หน้าแรกเกือบว่างหรือไม่มีรหัสวิชาจะขึ้นที่นี่</span></div></div>
<% } %>
  </div>
<% } %>
</div>
<%- include('../partials/bottom') %>
