<%- include('partials/top') %>
<% const T = wf.DOC_TYPES[sub.doc_type]; const methods = util.parseJson(sub.teaching_methods, []);
   // ฟอร์มแบบสั้น (ฟังก์ชันเสริม formshort) วิชาที่ระบบเติมครบแล้วเหลือบรรทัดเดียว กดเปลี่ยนวิชาเพื่อเปิดช่องเดิม
   const fsSubj = ff.formshort && sub.subject_code && sub.subject_name && sub.grade_level; %>
<div class="narrow" style="max-width:860px">
  <div class="page-head">
    <div>
      <% if (locals.proxy) { %><div class="eyebrow">ผู้ดูแลระบบ</div><% } %>
      <h1><%= isNew ? 'ส่ง' : 'แก้ไข' %><%= T.label %><%= locals.proxy ? 'แทนครู' : '' %></h1>
      <% if (locals.proxy) { %><div class="sub">ในชื่อของ <b><%= proxy.full_name %></b> ภาคเรียนที่ <%= sub.semester %>/<%= sub.academic_year %></div><% } else { %>
      <div class="sub">ภาคเรียนที่ <%= sub.semester %>/<%= sub.academic_year %> ส่ง 1 รายวิชาต่อ 1 ครั้ง<%= ff.onemain ? (sub.doc_type === 'plan' ? ' แผนส่งเฉพาะวิชาหลัก' : ' คู่มือส่งทุกวิชาที่สอน') : '' %></div><% } %>
    </div>
    <% if (!isNew) { %><div class="actions"><a class="btn btn-ghost" href="/s/<%= sub.id %>">ยกเลิก</a></div><% } %>
  </div>

  <% if (locals.lastReturn && sub.status === 'returned' && ff.retfocus) { %>
    <%- include('partials/return_box', { r: lastReturn, hint: 'แก้ตามความเห็นด้านบน แนบไฟล์ใหม่ถ้าต้องแก้ไฟล์ แล้วกด <b>ส่งอีกครั้งหลังแก้ไข</b> งานจะกลับไปที่ผู้ส่งคืนโดยตรง' }) %>
  <% } else if (locals.lastReturn && sub.status === 'returned') { %>
    <div class="alert alert-error"><%- icon('undo') %><div><b><%= lastReturn.user_name %></b> (<%= lastReturn.step_label %>) ส่งกลับให้แก้ไข
      <div class="pre" style="margin-top:6px;color:var(--ink)"><%= lastReturn.comment %></div></div></div>
  <% } %>
  <% if (locals.proxy) { %>
    <div class="alert alert-info"><%- icon('shield') %><span><b>งานนี้เป็นชื่อของ <%= proxy.full_name %></b> ครูเห็นงานนี้ในหน้าของตัวเองเหมือนส่งเอง<br>ระบบไม่ใส่ลายเซ็นครูแทน ช่องลายเซ็นครูในบันทึกข้อความเว้นว่างไว้ให้เซ็นมือ หรือครูกลับมาเข้าระบบแล้วกดยืนยันและใส่ลายเซ็นของตัวเอง<br>ระบบจดในประวัติของงานว่า ผู้ดูแลระบบสร้างและส่งแทน ส่งได้แม้ปิดรับแล้ว</span></div>
  <% } else if (!window.open && sub.status !== 'returned') { %>
    <div class="alert alert-warn"><%- icon('clock') %><span><%= window.reason %> ตอนนี้บันทึกร่างไว้ก่อนได้</span></div>
  <% } %>

  <form class="card js-upload" method="post" action="<%= isNew ? '/works' : '/s/' + sub.id %>" enctype="multipart/form-data">
    <input type="hidden" name="doc_type" value="<%= sub.doc_type %>">
    <% if (locals.proxy) { %><input type="hidden" name="for_teacher" value="<%= proxy.id %>"><% } %>
    <h2>ข้อมูลรายวิชา</h2>
    <% if (fsSubj) { %>
      <div class="fs-subj" data-fs-summary><div><b><%= sub.subject_code %> <%= sub.subject_name %></b> <span class="muted"><%= sub.grade_level %></span></div><button type="button" class="sb-link" data-fs-change>เปลี่ยนวิชา</button></div>
    <% } %>
    <div class="form-grid<%= fsSubj ? ' fs-one' : '' %>">
      <div class="field" data-fs-subj<%= fsSubj ? ' hidden' : '' %>>
        <label for="subject_code">รหัสวิชา <span class="req">*</span></label>
        <input type="text" id="subject_code" name="subject_code" value="<%= sub.subject_code || '' %>" list="subject-list" placeholder="เช่น ว30203" data-subject-code autocomplete="off">
        <datalist id="subject-list">
          <% for (const x of subjects) { %><option value="<%= x.code %>" data-name="<%= x.name %>" data-grade="<%= x.grade %>"><%= x.name %></option><% } %>
        </datalist>
      </div>
      <div class="field" style="grid-column:span 2" data-fs-subj<%= fsSubj ? ' hidden' : '' %>>
        <label for="subject_name">ชื่อวิชา <span class="req">*</span></label>
        <input type="text" id="subject_name" name="subject_name" value="<%= sub.subject_name || '' %>" placeholder="เช่น ฟิสิกส์เพิ่มเติม 3">
      </div>
      <div class="field" data-fs-subj<%= fsSubj ? ' hidden' : '' %>>
        <label for="grade_level">ระดับชั้น <span class="req">*</span></label>
        <select id="grade_level" name="grade_level">
          <option value="">เลือกระดับชั้น</option>
          <% for (const g of util.lines(settings.grade_levels)) { %><option <%= sub.grade_level === g ? 'selected' : '' %>><%= g %></option><% } %>
        </select>
      </div>
      <% if (ff.docnoreq) { const need = !sub.submitted_at; const shared = typeof sharedNo !== 'undefined' && sharedNo; const num = docno.numOf(sub.doc_no || (shared && shared.no) || ''); %>
      <div class="field">
        <label for="doc_no_num">เลขที่บันทึกข้อความ<% if (need) { %> <span class="req">*</span><% } %></label>
        <div class="docno-in"><span><%= docnoPre %></span><input type="text" id="doc_no_num" name="doc_no_num" inputmode="numeric" maxlength="6" value="<%= num %>" placeholder="เลขที่ขอ" autocomplete="off" data-docno><span>/<%= docnoYear %></span></div>
        <% if (shared && num) { %><div class="hint docno-shared"><%- icon('check', 14) %> ใช้เลขเดียวกับคู่มือ <%= shared.code %> ระบบเติมให้แล้ว ไม่ต้องขอเลขใหม่ (แก้ได้ถ้าห้องวิชาการให้เลขอื่น)</div><% } else { %>
        <div class="hint"><%= ff.formshort ? 'ขอเลขที่ห้องวิชาการ แล้วพิมพ์เฉพาะตัวเลข' : 'ขอเลขที่ห้องวิชาการก่อน แล้วพิมพ์เฉพาะตัวเลข ระบบเติม ' + docnoPre + ' และ /' + docnoYear + ' ให้' %><% if (sub.doc_no && !num) { %> (เลขเดิม <%= sub.doc_no %> พิมพ์ใหม่เฉพาะตัวเลข)<% } %></div><% } %>
      </div>
      <% } else { %>
      <div class="field">
        <label for="doc_no">เลขที่บันทึกข้อความ</label>
        <input type="text" id="doc_no" name="doc_no" value="<%= sub.doc_no || '' %>" placeholder="ถ้ามี เช่น วก.214/2569">
        <div class="hint">เว้นว่างได้ ใบที่พิมพ์จะเว้นช่องไว้ให้</div>
      </div>
      <% } %>
    </div>

    <% if (sub.doc_type === 'plan') { %>
      <% if (ff.formshort) { %><details class="howto fs-more"<%= methods.length ? ' open' : '' %>><summary>รูปแบบการจัดการเรียนรู้ที่ใช้ในแผน เลือกถ้ามี</summary><% } %>
      <div class="field">
        <span class="label">รูปแบบหรือแนวทางการจัดการเรียนรู้ที่ใช้ในแผน</span>
        <div class="checks">
          <% const methodList = util.lines(settings.teaching_methods); for (const m of methodList) { %>
            <label class="check"><input type="checkbox" name="teaching_methods" value="<%= m %>" <%= methods.includes(m) ? 'checked' : '' %>> <%= m %></label>
          <% } %>
        </div>
      </div>
      <% if (ff.methodother) { %>
      <div class="field">
        <label for="teaching_methods_other">อื่น ๆ (ระบุ)</label>
        <input type="text" id="teaching_methods_other" name="teaching_methods_other" maxlength="300" value="<%= methods.filter((m) => !methodList.includes(m)).join(', ') %>" placeholder="เช่น การเรียนรู้แบบโครงงาน">
        <div class="hint">ถ้ามีหลายรูปแบบ คั่นด้วยเครื่องหมายจุลภาค</div>
      </div>
      <% } %>
      <% if (ff.formshort) { %></details><% } %>
    <% } %>

    <h2 style="margin-top:18px">ไฟล์<%= T.label %></h2>
    <% if (ff.pdfonly) { const oldOk = files.length === 1 && files[0].mime === 'application/pdf'; %>
      <%# หมายเหตุเหนือช่องเลือกไฟล์: ต้องมีปกและเนื้อหา หน้าแรกจะเป็นปกในคลังงาน (ฟังก์ชันเสริม library) %>
      <div class="<%= ff.callout ? 'call check' : 'alert alert-info' %> lib-filenote"><%- icon('file') %><span><% if (ff.formshort) { %>ไฟล์ต้องมี<b>หน้าปกและเนื้อหา</b><%= ff.pdfmerge ? ' เลือกหลายไฟล์ได้ ระบบรวมให้' : ' รวมเป็น PDF ไฟล์เดียวก่อนแนบ' %><% if (ff.library) { %> <b>หน้าแรกจะเป็นปกในคลังงาน</b><% } %><% } else { %><% if (ff.callout) { %><span class="call-tag">ควรตรวจ</span><% } %>ไฟล์ต้องมี<b>หน้าปกและเนื้อหา</b> <%= ff.pdfmerge ? 'รวมเป็น PDF ไฟล์เดียวมาเอง หรือเลือกหลายไฟล์ เช่น ปกกับเนื้อหา แล้วเรียงด้วยปุ่มขึ้นลง เว็บจะรวมให้ก็ได้' : 'รวมเป็น PDF ไฟล์เดียวก่อนแนบ' %><% if (ff.library) { %> <b>หน้าแรกจะเป็นปกในคลังงาน</b><% } %><% } %></span></div>
      <% if (files.length) { %>
        <ul class="file-list" style="margin-bottom:10px">
          <% for (const f of files) { %>
            <li><%- icon('file', 20) %><a class="fname" href="/f/<%= f.id %>/view" target="_blank" rel="noopener"><%= f.original_name %></a>
              <small class="muted"><%= util.fileSize(f.size) %></small></li>
          <% } %>
        </ul>
        <% if (!oldOk) { %>
          <div class="alert alert-warn"><%- icon('file') %><span>ไฟล์ที่แนบไว้เดิม<%= files.length > 1 ? 'มี ' + files.length + ' ไฟล์' : 'ไม่ใช่ PDF' %> ตอนนี้ระบบรับ PDF ไฟล์เดียว กรุณาแนบ PDF ใหม่ ไฟล์เดิมจะเก็บไว้ในประวัติ</span></div>
        <% } else { %>
          <p class="hint">แนบไฟล์ใหม่ด้านล่างเมื่อต้องการเปลี่ยน ไฟล์เดิมจะเก็บไว้ในประวัติ</p>
        <% } %>
      <% } %>
      <label class="dropzone" data-dropzone data-accept="pdf" <%= ff.pdfmerge ? 'data-sortable' : 'data-single' %><%- ff.precheck && ff.coverpreview && oldOk ? ' data-old-cover="' + Number(files[0].id) + '"' : '' %> <%= ff.library ? 'data-thumb' : '' %> <%= ff.filecheck ? 'data-filecheck' : '' %> data-max-mb="<%= settings.max_upload_mb %>">
        <span class="dz-icon"><%- icon('send', 34) %></span>
        <b>ลากไฟล์ PDF มาวางที่นี่ หรือกดเพื่อเลือกไฟล์</b><br>
        <small class="muted">เฉพาะ PDF ไม่เกิน <%= settings.max_upload_mb %> MB ต่อไฟล์<%= ff.pdfmerge ? ' เลือกได้หลายไฟล์ ระบบรวมให้' : '' %></small>
        <input type="file" name="main_files" <%= ff.pdfmerge ? 'multiple' : '' %> accept=".pdf,application/pdf">
      </label>
      <ul class="dz-list" data-dz-list></ul>
      <p class="hint" data-dz-merge hidden></p>
      <% if (ff.coverpreview) { %>
        <div class="cover-preview" data-cover hidden>
          <div data-cover-img></div>
          <div><b>หน้าปกที่จะส่ง</b><br><small class="muted" data-cover-info></small><br><% if (ff.library) { %><small><b>ภาพนี้จะเป็นปกในคลังงาน</b></small><br><% } %><small class="muted">ถ้าหน้านี้ไม่ใช่ปก ให้เลื่อนไฟล์ปกขึ้นไว้บนสุด หรือเลือกไฟล์ใหม่</small></div>
          <% if (ff.precheck && ff.blankcover) { %><div class="cv-warn" data-cover-warn hidden><%- icon('eye', 26) %><div><b>หน้าแรกดูเหมือนไม่ใช่ปก</b><span>หน้านี้แทบไม่มีตัวหนังสือ ถ้าปกอยู่อีกไฟล์ ให้เลือกไฟล์ปกเพิ่มแล้วเลื่อนไว้บนสุด ถ้ายังไม่ได้ทำปก ให้ทำปกก่อน</span></div></div><% } %>
        </div>
      <% } %>
      <details class="howto">
        <summary>มีแต่ไฟล์ Word ทำอย่างไร</summary>
        <ol>
          <li><b>Word บน Windows</b> เปิดไฟล์ กด ไฟล์ (File) แล้วเลือก บันทึกเป็น (Save As) ช่องชนิดไฟล์เลือก PDF แล้วกดบันทึก</li>
          <li><b>Word บน Mac</b> เปิดไฟล์ กด File แล้วเลือก Save As ช่อง File Format เลือก PDF แล้วกด Export</li>
          <li><b>Google Docs</b> เปิดไฟล์ กด ไฟล์ เลือก ดาวน์โหลด แล้วเลือก เอกสาร PDF</li>
          <li>ถ้าปกกับเนื้อหาอยู่คนละไฟล์ บันทึกเป็น PDF ทั้งสองไฟล์<%= ff.pdfmerge ? ' แล้วเลือกมาพร้อมกันที่ช่องด้านบน ระบบจะรวมให้' : ' แล้วรวมเป็นไฟล์เดียวก่อนแนบ' %></li>
        </ol>
      </details>
    <% } else { %>
      <% if (files.length) { %>
        <ul class="file-list" style="margin-bottom:10px">
          <% for (const f of files) { %>
            <li><%- icon('file', 20) %><a class="fname" href="/f/<%= f.id %>/view" target="_blank" rel="noopener"><%= f.original_name %></a>
              <small class="muted"><%= util.fileSize(f.size) %></small>
              <label class="check"><input type="checkbox" name="remove_files" value="<%= f.id %>"> เอาไฟล์นี้ออก</label></li>
          <% } %>
        </ul>
      <% } %>
      <div class="alert alert-info lib-filenote"><%- icon('file') %><span>ไฟล์ต้องมี<b>หน้าปกและเนื้อหา</b><% if (ff.library) { %> <b>หน้าแรกของไฟล์ PDF ไฟล์แรกจะเป็นปกในคลังงาน</b><% } %></span></div>
      <label class="dropzone" data-dropzone <%= ff.library ? 'data-thumb' : '' %> <%= ff.filecheck ? 'data-filecheck' : '' %> data-max-mb="<%= settings.max_upload_mb %>">
        <span class="dz-icon"><%- icon('send', 34) %></span>
        <b>ลากไฟล์มาวางที่นี่ หรือกดเพื่อเลือกไฟล์</b><br>
        <small class="muted">PDF Word Excel PowerPoint หรือรูปภาพ ไม่เกิน <%= settings.max_upload_mb %> MB ต่อไฟล์ เลือกได้หลายไฟล์</small>
        <input type="file" name="main_files" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png">
      </label>
      <ul class="dz-list" data-dz-list></ul>
    <% } %>
    <% if (ff.filecheck && !ff.formshort) { %><p class="hint"><%- icon('check', 16) %> ระบบตรวจไฟล์ให้ทันทีที่เลือก ชนิดไฟล์ ขนาด ไฟล์เปิดได้ และจำนวนหน้า PDF</p><% } %>

    <%# ลิงก์พับไว้เฉพาะตอนส่ง PDF อย่างเดียว ถ้าปิด pdfonly ลิงก์ใช้แทนไฟล์ได้จึงต้องเห็นเสมอ %>
    <% const fsLink = ff.formshort && ff.pdfonly; %>
    <% if (fsLink) { %><details class="howto fs-more"<%= sub.link_url ? ' open' : '' %>><summary>เพิ่มลิงก์ เช่น Google Drive ถ้ามี</summary><% } %>
    <div class="field" style="margin-top:14px">
      <label for="link_url">ลิงก์เพิ่มเติม</label>
      <input type="url" id="link_url" name="link_url" value="<%= sub.link_url || '' %>" placeholder="เช่น ลิงก์ Google Drive หรือ Canva ถ้ามี">
      <div class="hint"><%= ff.pdfonly ? 'ไม่บังคับ ใส่ได้ถ้ามีสื่อหรือไฟล์ประกอบเพิ่มเติม' : 'ต้องมีไฟล์หรือลิงก์อย่างน้อย 1 อย่างจึงจะส่งได้' %></div>
    </div>
    <% if (fsLink) { %></details><% } else { %>

    <hr><% } %>
<% if (locals.pc) { %>
    <% if (ff.coverconfirm) { %><input type="hidden" name="cover_check" value="1"><% } %>
    <%- include('partials/precheck', { pc, sub, files, mode: 'form' }) %>
    <% if (ff.frontcheck) { %><input type="hidden" name="front_check" data-front-check><% } %>
<% } else if (ff.coverconfirm) { %>
    <input type="hidden" name="cover_check" value="1">
    <label class="check cover-ok"><input type="checkbox" name="cover_ok" value="1"> <span>ฉันตรวจแล้ว <b>ไฟล์นี้มีหน้าปก</b> และ<b>หน้าปกอยู่หน้าแรก</b><% if (ff.coverpreview) { %> ตามภาพหน้าปกที่จะส่งด้านบน<% } %></span></label>
    <p class="hint">ถ้าหน้าแรกไม่ใช่ปก: ถ้าปกอยู่อีกไฟล์ ให้เลือกไฟล์ปกเพิ่มแล้วเลื่อนไว้บนสุด ถ้ายังไม่ได้ทำปก ให้ทำปกก่อนแล้วค่อยส่ง บันทึกร่างไว้ก่อนได้โดยไม่ต้องติ๊ก</p>
<% } %>
    <div class="btn-row">
      <button class="btn btn-ghost btn-lg" type="submit" name="action" value="draft">บันทึกร่าง</button>
      <button class="btn btn-primary btn-lg" type="submit" name="action" value="submit"<% if (ff.coverconfirm) { %> data-need-checked="cover_ok" data-need-message="ติ๊กยืนยันก่อนว่าไฟล์นี้มีหน้าปก และหน้าปกอยู่หน้าแรก ถ้ายังไม่มีปก ให้ทำปกก่อน หรือกดบันทึกร่างไว้ก่อน"<% } %>
        data-confirm="ยืนยันส่ง<%= T.label %>ให้ผู้ตรวจ
หลังส่งแล้วจะแก้ไขได้เมื่อถูกส่งกลับ หรือดึงกลับก่อนมีผู้ลงนาม" data-ok-label="ส่งเลย"<%= sub.teacher_id && sub.teacher_id !== me.id ? '' : ' data-need-sig' %><%- locals.pc ? ' data-precheck-btn' : '' %>><%- icon('send', 20) %> <%= sub.status === 'returned' ? 'ส่งอีกครั้งหลังแก้ไข' : 'ส่งให้ผู้ตรวจ' %></button>
    </div>
    <% if (locals.pc) { %><p class="hint ck-btn-note" data-ck-note hidden></p><% } %>
  </form>
</div>
<%- include('partials/bottom') %>
