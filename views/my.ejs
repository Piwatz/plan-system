<%- include('partials/top') %>
<% const T = wf.DOC_TYPES; %>
<div class="page-head">
  <div>
    <h1>งานของฉัน</h1>
    <div class="sub">แต่ละรายวิชาส่งแผนการจัดการเรียนรู้และคู่มือรายวิชาแยกกัน แล้วเขียนบันทึกหลังแผนทีละแผน</div>
  </div>
  <div class="actions">
    <%- include('partials/term_select') %>
    <% if (isCurrent) { %>
      <% if (canPlan) { %><a class="btn btn-primary" href="/works/new?type=plan">ส่งแผน</a><% } %>
      <a class="btn btn-ghost" href="/works/new?type=manual">ส่งคู่มือรายวิชา</a>
    <% } %>
  </div>
</div>

<% if (isCurrent && !window.open) { %>
  <div class="alert alert-warn"><%= window.reason %> ยังบันทึกร่างไว้ก่อนได้ งานที่ถูกส่งกลับให้แก้ไขยังส่งใหม่ได้ตามปกติ</div>
<% } %>

<% if (!subjects.length) { %>
  <div class="card"><div class="empty"><span class="big"></span>ยังไม่มีงานในภาคเรียนนี้<br>เริ่มจากกด <b>ส่งคู่มือรายวิชา</b> หรือ <b>ส่งแผน</b> ของแต่ละรายวิชา</div></div>
<% } %>

<% for (const s of subjects) { %>
  <div class="card<%= ff.mycards ? ' has-boxes' : '' %>">
    <div class="card-head">
      <h2><%= s.code %> <%= s.name %></h2>
      <% if (s.grade) { %><span class="badge badge-brand"><%= s.grade %></span><% } %>
    </div>
    <div class="table-wrap"><table class="table">
      <tbody>
        <% for (const type of ['plan', 'manual']) { const w = s[type]; %>
          <tr>
            <td style="width:34%"><b><%= T[type].label %></b></td>
            <% if (w) { %>
              <td><%- include('partials/status', { s: w }) %>
                <% if (w.score_max) { %> <span class="badge badge-blue">คะแนน <%= w.score_total %>/<%= w.score_max %> <%= wf.scoreLevel(w.score_total / w.score_max * 100) %></span><% } %>
              </td>
              <td class="right nowrap">
                <a class="btn btn-sm <%= w.status === 'returned' ? 'btn-danger' : 'btn-ghost' %>" href="/s/<%= w.id %>"><%= w.status === 'returned' ? 'แก้ไข' : w.status === 'draft' ? 'เปิดร่าง' : 'ดูรายละเอียด' %></a>
                <% if (ff.printrow && w.status !== 'draft') { %><div class="my-print"><a class="btn btn-sm btn-ghost" href="/s/<%= w.id %>/print" target="_blank" rel="noopener"><%- icon('print', 16) %> พิมพ์บันทึกข้อความ</a><% if (w.score_max) { %><a class="btn btn-sm btn-ghost" href="/s/<%= w.id %>/print?doc=eval" target="_blank" rel="noopener"><%- icon('print', 16) %> พิมพ์แบบประเมิน</a><% } %><% if (w.main_file_id) { %><a class="btn btn-sm btn-ghost" href="/f/<%= w.main_file_id %>/view" target="_blank" rel="noopener"><%- icon('file', 16) %> เปิดไฟล์<%= type === 'plan' ? 'แผน' : 'คู่มือ' %></a><% } %></div><% } %>
              </td>
            <% } else { %>
              <td><span class="muted"><%= type === 'plan' && !canPlan ? 'ไม่ต้องส่ง ส่งแผนเฉพาะวิชาหลัก' : 'ยังไม่ได้ส่ง' %></span></td>
              <td class="right nowrap"><% if (isCurrent && (type !== 'plan' || canPlan)) { const other = s.manual || s.plan; %><a class="btn btn-sm btn-primary" href="/works/new?type=<%= type %><%= other ? '&from=' + other.id : '' %>">ส่ง<%= T[type].label %></a><% } %></td>
            <% } %>
          </tr>
        <% } %>
        <tr>
          <td><b>บันทึกหลังแผน</b></td>
          <% if (s.plan && s.plan.status !== 'draft') { %>
            <td>
              <%= s.plan.note_total %> ฉบับ <span class="muted">ลงนามครบ <%= s.plan.note_done %></span>
              <% if (s.plan.note_todo) { %> <span class="badge badge-gray">ร่างหรือรอแก้ <%= s.plan.note_todo %></span><% } %>
            </td>
            <td class="right nowrap">
              <a class="btn btn-sm btn-ghost" href="/s/<%= s.plan.id %>#notes">ดูทั้งหมด</a>
              <a class="btn btn-sm btn-warn" href="/notes/new?plan=<%= s.plan.id %>">เขียนบันทึก</a>
              <% if (ff.printrow && s.plan.note_total - s.plan.note_todo > 0) { %><div class="my-print"><a class="btn btn-sm btn-ghost" href="/s/<%= s.plan.id %>/print-notes" target="_blank" rel="noopener"><%- icon('print', 16) %> พิมพ์ทั้งเล่ม</a></div><% } %>
            </td>
          <% } else { %>
            <td colspan="2"><span class="muted">เขียนได้หลังจากส่งแผนการจัดการเรียนรู้ของวิชานี้แล้ว</span></td>
          <% } %>
        </tr>
      </tbody>
    </table></div>
    <% if (ff.mycards) { %>
    <%# จอมือถือ (ฟังก์ชันเสริม mycards): กล่องละงาน ขอบซ้ายสีตามสถานะ ปุ่มหลักปุ่มเดียว ปุ่มรองเป็นลิงก์เล็ก · จอกว้างยังเป็นตาราง %>
    <div class="my-boxes">
      <% for (const type of ['plan', 'manual']) { const w = s[type]; const tone = w ? { approved: 'ok', returned: 'back', pending: 'wait' }[w.status] || 'none' : 'none'; %>
        <div class="my-box tone-<%= tone %>">
          <div class="mb-head"><b><%= T[type].label %></b><% if (w) { %><%- include('partials/status', { s: w }) %><% } %></div>
          <% if (w) { %>
            <% if (w.score_max) { %><div class="muted small">คะแนน <%= w.score_total %>/<%= w.score_max %> <%= wf.scoreLevel(w.score_total / w.score_max * 100) %></div><% } %>
            <a class="btn btn-block <%= w.status === 'returned' ? 'btn-danger' : w.status === 'draft' ? 'btn-primary' : 'btn-ghost' %>" href="/s/<%= w.id %>"><%= w.status === 'returned' ? 'แก้ไขแล้วส่งใหม่' : w.status === 'draft' ? 'เปิดร่าง' : 'ดูรายละเอียด' %></a>
            <% if (ff.printrow && w.status !== 'draft') { %><div class="mb-links"><a href="/s/<%= w.id %>/print" target="_blank" rel="noopener">พิมพ์บันทึกข้อความ</a><% if (w.score_max) { %><a href="/s/<%= w.id %>/print?doc=eval" target="_blank" rel="noopener">พิมพ์แบบประเมิน</a><% } %><% if (w.main_file_id) { %><a href="/f/<%= w.main_file_id %>/view" target="_blank" rel="noopener">เปิดไฟล์</a><% } %></div><% } %>
          <% } else { %>
            <div class="muted small"><%= type === 'plan' && !canPlan ? 'ไม่ต้องส่ง ส่งแผนเฉพาะวิชาหลัก' : 'ยังไม่ได้ส่ง' %></div>
            <% if (isCurrent && (type !== 'plan' || canPlan)) { const other = s.manual || s.plan; %><a class="btn btn-block btn-primary" href="/works/new?type=<%= type %><%= other ? '&from=' + other.id : '' %>">ส่ง<%= T[type].label %></a><% } %>
          <% } %>
        </div>
      <% } %>
      <% const p = s.plan && s.plan.status !== 'draft' ? s.plan : null; const noteTone = !p || !p.note_total ? 'none' : p.note_done === p.note_total ? 'ok' : 'wait'; %>
      <div class="my-box tone-<%= noteTone %>">
        <div class="mb-head"><b>บันทึกหลังแผน</b><% if (p) { %><span class="muted small"><%= p.note_total %> ฉบับ ลงนามครบ <%= p.note_done %></span><% } %></div>
        <% if (p) { %>
          <a class="btn btn-block btn-warn" href="/notes/new?plan=<%= p.id %>">เขียนบันทึก</a>
          <div class="mb-links"><a href="/s/<%= p.id %>#notes">ดูทั้งหมด</a><% if (ff.printrow && p.note_total - p.note_todo > 0) { %><a href="/s/<%= p.id %>/print-notes" target="_blank" rel="noopener">พิมพ์ทั้งเล่ม</a><% } %></div>
        <% } else { %>
          <div class="muted small">เขียนได้หลังจากส่งแผนการจัดการเรียนรู้ของวิชานี้แล้ว</div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
<% } %>
<%- include('partials/bottom') %>
