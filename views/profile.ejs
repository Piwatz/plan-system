<%- include('partials/top') %>
<div class="narrow">
  <div class="page-head"><div><h1>ข้อมูลส่วนตัวและลายเซ็น</h1><div class="sub">ชื่อ ตำแหน่ง และลายเซ็นนี้จะใช้ในบันทึกข้อความและเอกสารที่พิมพ์จากระบบ</div></div></div>
<% if (stale) { %>
  <div class="alert alert-info resign-bar">
    <div class="t"><b>มีงานที่ลงนามด้วยลายเซ็นเดิม <%= stale %> งาน</b><div class="small">กดเพื่อใช้ลายเซ็นปัจจุบันในทุกงานนั้น หรือเปลี่ยนทีละงานในหน้างาน</div></div>
    <form method="post" action="/profile/resign-all" data-confirm="ใช้ลายเซ็นปัจจุบันแทนลายเซ็นเดิมในงานที่ลงนามหรือส่งไปแล้วทั้ง <%= stale %> งาน ใช่ไหม เอกสารที่พิมพ์จากนี้จะเป็นลายเซ็นใหม่" data-ok-label="ใช้ลายเซ็นใหม่"><button class="btn btn-primary btn-sm" type="submit">ใช้ลายเซ็นใหม่ทั้ง <%= stale %> งาน</button></form>
  </div>
<% } %>
<% if (blank.length) { %>
  <div class="alert alert-warn sigfill-bar">
    <div class="t"><b>มี <%= blank.length %> งานที่ส่งไปตอนยังไม่มีลายเซ็น</b>
      <ul class="small"><% for (const w of blank.slice(0, 8)) { %><li><%= w %></li><% } %><% if (blank.length > 8) { %><li>และอีก <%= blank.length - 8 %> งาน</li><% } %></ul>
      <% if (!me.signature) { %><div class="small">เซ็นชื่อในกรอบด้านล่างแล้วกดบันทึก<%= ff.sigfillauto ? ' ระบบใส่ลายเซ็นในงานเหล่านี้ให้ทันที' : '' %></div><% } %>
    </div>
    <% if (me.signature && ff.sigfill) { %>
    <form method="post" action="/profile/sigfill" data-confirm="ใส่ลายเซ็นของคุณในงานที่ส่งไปตอนยังไม่มีลายเซ็นทั้ง <%= blank.length %> งาน ใช่ไหม ไม่ต้องส่งงานใหม่ ผู้ตรวจไม่ต้องลงนามใหม่" data-ok-label="ใส่ลายเซ็น"><button class="btn btn-primary btn-sm" type="submit">ใส่ลายเซ็นของฉันในงานเหล่านี้</button></form>
    <% } %>
  </div>
<% } %>
  <form class="card" method="post" action="/profile">
    <dl class="info" style="margin-bottom:14px">
      <div><dt>ชื่อ สกุล</dt><dd><%= me.full_name %></dd></div>
      <div><dt>ชื่อผู้ใช้</dt><dd><%= me.username %></dd></div>
      <div><dt>กลุ่มสาระ</dt><dd><%= me.dept_name || '-' %></dd></div>
      <div><dt>หน้าที่ผู้ตรวจ</dt><dd><%= me.roles.map((r) => (wf.stepOf(r) || {}).label).filter(Boolean).join(' และ ') || '-' %></dd></div>
    </dl>
    <p class="muted small">ถ้าชื่อหรือกลุ่มสาระไม่ถูกต้อง แจ้งผู้ดูแลระบบให้แก้ไข</p>
    <div class="field">
      <label for="position">ตำแหน่งที่ใช้ในเอกสาร</label>
      <input type="text" id="position" name="position" value="<%= me.position %>" placeholder="เช่น ครู หรือ ครูผู้ช่วย หรือ ครู วิทยฐานะครูชำนาญการ">
    </div>
    <div class="field">
      <span class="label">ลายเซ็น</span>
      <% if (me.signature) { %>
        <div class="btn-row" style="margin-bottom:10px">
          <span class="sig-box"><img class="sig-preview" src="<%= me.signature %>" alt="ลายเซ็นปัจจุบัน"></span>
          <label class="check"><input type="checkbox" name="remove_signature" value="1"> ลบลายเซ็นนี้</label>
        </div>
        <p class="muted small">ถ้าต้องการเปลี่ยน ให้เซ็นใหม่ในกรอบด้านล่าง</p>
      <% } %>
      <%- include('partials/sigpad', { preview: true }) %>
      <div class="hint">เซ็นบนมือถือด้วยนิ้วได้ หรือถ่ายรูปลายเซ็นบนกระดาษขาวแล้วกดใช้รูปจากไฟล์</div>
    </div>
    <button class="btn btn-primary" type="submit" data-confirm="บันทึกข้อมูลส่วนตัวและลายเซ็น">บันทึก</button>
    <a class="btn btn-ghost" href="/password">เปลี่ยนรหัสผ่าน</a>
  </form>
<% if (ff.sigclean) { %>
  <dialog class="modal sig-doc-dialog" id="sig-doc"<% if (me.signature) { %> data-current="<%= me.signature %>"<% } %>>
    <h3>ตัวอย่างบนเอกสาร ขนาดเท่าตอนพิมพ์</h3>
    <div class="sig-paper">
      <div class="sp-line">จึงเรียนมาเพื่อโปรดพิจารณา</div>
      <div class="sp-sign">
        <div class="sp-sig sp-teacher"><img alt="ลายเซ็น" data-sig-img></div>
        <div>(<%= me.full_name %>)</div>
        <div><%= me.position || 'ครู' %></div>
      </div>
      <div class="sp-box">
        <div>ความเห็นของผู้ตรวจ</div>
        <div class="sp-row">ลงชื่อ <span class="sp-dots"><span class="sp-sig sp-review"><img alt="ลายเซ็น" data-sig-img></span></span></div>
        <div>(<%= me.full_name %>)</div>
      </div>
    </div>
    <p class="muted small" data-sig-empty hidden>ยังไม่มีลายเซ็น เซ็นในกรอบหรือเลือกรูปก่อน</p>
    <div class="modal-actions"><button type="button" class="btn btn-primary btn-lg" data-sig-close>ปิด</button></div>
  </dialog>
<% } %>
</div>
<%- include('partials/bottom') %>
