{
  "//": "ใช้ตรวจลืม await เท่านั้น ไม่สร้างไฟล์: npx tsc -p tsconfig.check.json แล้วดูเฉพาะ error ที่พูดถึง Promise",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "module": "nodenext",
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "moduleResolution": "nodenext"
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",
    "server.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "spike"
  ]
}
